<UserControl x:Class="ProjectSoundboard.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProjectSoundboard.App.ViewModels"
             xmlns:views="clr-namespace:ProjectSoundboard.App.Views"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <!-- ================================================================ -->
        <!-- Shared pieces of a sound tile                                     -->
        <!-- ================================================================ -->

        <!-- Thumbnail: user image if there is one, otherwise a generated letter tile -->
        <DataTemplate x:Key="SoundArt">
            <Grid>
                <Border CornerRadius="10" ClipToBounds="True"
                        Background="{Binding AutoColor, Converter={StaticResource StringToBrush}}">
                    <Grid>
                        <TextBlock Text="{Binding Initial}" FontSize="26" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Opacity="0.92"/>
                        <TextBlock Text="{Binding Emoji}" FontSize="28" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasEmoji, Converter={StaticResource BoolToVisibility}}"/>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Border>

                <!-- Playing pulse -->
                <Border CornerRadius="10" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                        Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </DataTemplate>

        <!--
            A ContextMenu is hosted in its own popup, so it is not inside this UserControl's
            visual tree and RelativeSource AncestorType=UserControl can never resolve from
            here. Every command has to be reached through PlacementTarget instead: each tile
            carries the page view model in its Tag, and its DataContext is the sound itself.
        -->
        <ContextMenu x:Key="SoundContextMenu">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="CommandParameter"
                            Value="{Binding PlacementTarget.DataContext,
                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                </Style>
            </ContextMenu.Resources>

            <MenuItem Header="Play" InputGestureText="Click"
                      Command="{Binding PlacementTarget.Tag.PlayCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Stop this sound"
                      Command="{Binding PlacementTarget.Tag.StopSoundCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator Background="{DynamicResource BorderBrushSoft}" Height="1" Margin="6,4"/>
            <MenuItem Header="Add to / remove from favourites"
                      Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Assign a hotkey…"
                      Command="{Binding PlacementTarget.Tag.AssignHotkeyCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator Background="{DynamicResource BorderBrushSoft}" Height="1" Margin="6,4"/>
            <MenuItem Header="Move to group…"
                      Command="{Binding PlacementTarget.Tag.MoveToGroupCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Remove from group"
                      Command="{Binding PlacementTarget.Tag.RemoveFromGroupCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator Background="{DynamicResource BorderBrushSoft}" Height="1" Margin="6,4"/>
            <MenuItem Header="Open file location"
                      Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Remove from library"
                      Command="{Binding PlacementTarget.Tag.RemoveFromLibraryCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

        <!-- ================================================================ -->
        <!-- Grid tile                                                         -->
        <!-- ================================================================ -->
        <DataTemplate x:Key="GridTile">
            <Border x:Name="Root" Margin="5" CornerRadius="12" Padding="9"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                    ContextMenu="{StaticResource SoundContextMenu}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    ToolTipService.InitialShowDelay="600">
                <Border.ToolTip>
                    <StackPanel MaxWidth="330">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding OriginalFileName}" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0">
                            <Run Text="{Binding DurationSeconds, Mode=OneWay, Converter={StaticResource Duration}}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding QualityText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border.ToolTip>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SoundArt}"/>

                        <!-- Favourite star -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5"
                                CornerRadius="9" Padding="4,2" Background="#66000000"
                                Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="10.5"
                                       Foreground="#FFD166"/>
                        </Border>

                        <!-- Problem badge -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5"
                                CornerRadius="9" Padding="5,2"
                                Background="{DynamicResource DangerBrush}"
                                Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="White"/>
                        </Border>

                        <!-- Progress while playing -->
                        <ProgressBar VerticalAlignment="Bottom" Height="4" Margin="4"
                                     Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                     Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="2,7,2,0">
                        <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" MaxHeight="34" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding DurationSeconds, Converter={StaticResource Duration}}"
                                   Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource ElevatedBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ================================================================ -->
        <!-- Compact tile                                                      -->
        <!-- ================================================================ -->
        <DataTemplate x:Key="CompactTile">
            <Border x:Name="Root" Margin="4,3" CornerRadius="9" Padding="8,6"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                    ContextMenu="{StaticResource SoundContextMenu}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="34" Height="34">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SoundArt}"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding DurationSeconds, Converter={StaticResource Duration}}"
                                   Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ================================================================ -->
        <!-- Detailed list row                                                 -->
        <!-- ================================================================ -->
        <DataTemplate x:Key="ListRow">
            <Border x:Name="Root" Padding="10,7" CornerRadius="8" Margin="4,1"
                    Background="Transparent" ContextMenu="{StaticResource SoundContextMenu}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="30" Height="30">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SoundArt}"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OriginalFileName}" Style="{StaticResource MutedText}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding GroupName}" VerticalAlignment="Center"
                               Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="{Binding TagsText}" VerticalAlignment="Center"
                               Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="4" VerticalAlignment="Center" TextAlignment="Right"
                               Style="{StaticResource SecondaryText}"
                               Text="{Binding DurationSeconds, Converter={StaticResource Duration}}"/>
                    <TextBlock Grid.Column="5" VerticalAlignment="Center" TextAlignment="Right"
                               Style="{StaticResource MutedText}" Text="{Binding PlayCount}"
                               ToolTip="Times played"/>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Container style: strips the default ListBox selection chrome -->
        <Style x:Key="SoundItemContainer" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar tree -->
        <HierarchicalDataTemplate x:Key="NodeTemplate" DataType="{x:Type vm:LibraryNode}"
                                  ItemsSource="{Binding Children}">
            <Border Padding="4,5" Background="Transparent" AllowDrop="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                            Background="{Binding Color, Converter={StaticResource StringToBrush}}"
                            Visibility="{Binding Color, Converter={StaticResource EmptyStringToVisibility}}"/>

                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="7,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" Margin="8,0,4,0"/>
                </Grid>
            </Border>
        </HierarchicalDataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" MinWidth="170" MaxWidth="420"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*" MinWidth="360"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================== -->
        <!-- Sidebar                                                        -->
        <!-- ============================================================== -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="12,12,12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Library" FontWeight="SemiBold" FontSize="14"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="28" Height="28"
                                Content="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                Command="{Binding CreateGroupCommand}" ToolTip="New group"
                                AutomationProperties.Name="Create a new group"/>
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="10,8" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource BorderBrushSoft}">
                    <StackPanel>
                        <Button Content="Add a folder of sounds" HorizontalAlignment="Stretch"
                                Command="{Binding Settings.AddFolderCommand}" FontSize="12"/>
                        <Button Content="Import files…" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                Style="{StaticResource GhostButton}" FontSize="12"
                                Command="{Binding ImportFilesCommand}"
                                ToolTip="Same as dragging files onto the window"/>
                        <Button Content="Rescan library" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                Style="{StaticResource GhostButton}" FontSize="12"
                                Command="{Binding RescanCommand}" ToolTip="F5"/>
                    </StackPanel>
                </Border>

                <TreeView x:Name="NodeTree" Background="Transparent" BorderThickness="0"
                          ItemsSource="{Binding Nodes}" ItemTemplate="{StaticResource NodeTemplate}"
                          SelectedItemChanged="OnNodeSelected" Padding="6,0,6,8"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="Library groups">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="FontSize" Value="12.5"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TreeViewItem">
                                        <StackPanel>
                                            <Border x:Name="Bd" CornerRadius="8" Background="Transparent"
                                                    Padding="6,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton x:Name="Expander" Grid.Column="0"
                                                                  Focusable="False" Cursor="Hand"
                                                                  IsChecked="{Binding IsExpanded,
                                                                              RelativeSource={RelativeSource TemplatedParent},
                                                                              Mode=TwoWay}">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="Transparent" Padding="2">
                                                                    <Path x:Name="Arrow" Data="M 0,0 L 4,4 L 0,8"
                                                                          Stroke="{DynamicResource TextMutedBrush}"
                                                                          StrokeThickness="1.4"
                                                                          RenderTransformOrigin="0.4,0.5"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="Arrow" Property="RenderTransform">
                                                                            <Setter.Value>
                                                                                <RotateTransform Angle="90"/>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                    <ContentPresenter Grid.Column="1" ContentSource="Header"/>
                                                </Grid>
                                            </Border>
                                            <ItemsPresenter x:Name="Items" Margin="14,0,0,0"
                                                            Visibility="Collapsed"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsExpanded" Value="True">
                                                <Setter TargetName="Items" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <Trigger Property="HasItems" Value="False">
                                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource HoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource AccentSoftBrush}"/>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource TextPrimaryBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.ItemContainerStyle>

                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="New group" Command="{Binding CreateGroupCommand}"/>
                            <MenuItem Header="Rename group" Click="OnRenameGroupClick"/>
                            <MenuItem Header="Delete group"
                                      Command="{Binding DeleteGroupCommand}"
                                      CommandParameter="{Binding SelectedNode}"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"
                      AutomationProperties.Name="Resize the sidebar"/>

        <!-- ============================================================== -->
        <!-- Main area                                                      -->
        <!-- ============================================================== -->
        <DockPanel Grid.Column="2">

            <!-- Toolbar -->
            <Border DockPanel.Dock="Top" Padding="14,11" Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" MaxWidth="480" HorizontalAlignment="Left">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="34,7,30,7" FontSize="13"
                                 AutomationProperties.Name="Search sounds"
                                 ToolTip="Search names, file names, tags and groups"/>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Search sounds…" Margin="34,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Style="{StaticResource IconButton}" Width="24" Height="24"
                                HorizontalAlignment="Right" Margin="0,0,4,0" Content="&#xE8BB;"
                                FontFamily="Segoe MDL2 Assets" FontSize="9"
                                Command="{Binding ClearSearchCommand}"
                                AutomationProperties.Name="Clear search"
                                Visibility="{Binding SearchText, Converter={StaticResource EmptyStringToVisibility}}"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ComboBox Width="150" ItemsSource="{Binding SortModes}"
                                  SelectedItem="{Binding SortMode}" Margin="0,0,8,0"
                                  ToolTip="Sort order" AutomationProperties.Name="Sort order"/>

                        <Button Style="{StaticResource IconButton}" Content="&#xE8A9;"
                                FontFamily="Segoe MDL2 Assets" Command="{Binding CycleViewModeCommand}"
                                ToolTip="Switch layout: grid, compact, list (Ctrl+G)"
                                AutomationProperties.Name="Switch layout"/>

                        <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"
                                   Margin="8,0,4,0" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <Slider Width="90" Minimum="96" Maximum="220" VerticalAlignment="Center"
                                Value="{Binding TileSize}" ToolTip="Tile size"
                                AutomationProperties.Name="Tile size"
                                Visibility="{Binding ViewMode, Converter={StaticResource EqualsToVisibility},
                                             ConverterParameter=Grid}"/>

                        <Button Style="{StaticResource IconButton}" Content="&#xE7C4;"
                                FontFamily="Segoe MDL2 Assets" Margin="8,0,0,0"
                                Command="{Binding TogglePropertiesPanelCommand}"
                                ToolTip="Show or hide the details panel (Ctrl+P)"
                                AutomationProperties.Name="Toggle details panel"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Recent searches strip -->
            <Border DockPanel.Dock="Top" Padding="14,7" Background="{DynamicResource WindowBackgroundBrush}"
                    Visibility="{Binding ShowRecentSearches, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Recent:" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ItemsControl ItemsSource="{Binding RecentSearches}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Margin="0,0,6,0" Padding="9,3" FontSize="11.5"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding DataContext.UseRecentSearchCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Empty states -->
            <Grid>
                <ListBox x:Name="SoundList"
                         ItemsSource="{Binding Results}"
                         SelectedItem="{Binding SelectedSound}"
                         Style="{x:Null}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource SoundItemContainer}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         KeyboardNavigation.DirectionalNavigation="Contained"
                         PreviewMouseLeftButtonUp="OnSoundClicked"
                         KeyDown="OnSoundListKeyDown"
                         AutomationProperties.Name="Sounds">
                    <ListBox.Resources>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Padding" Value="8"/>
                        </Style>
                    </ListBox.Resources>
                </ListBox>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440"
                            Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="42"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding EmptyStateTitle}" FontSize="17" FontWeight="SemiBold"
                               Margin="0,14,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="{Binding EmptyStateMessage}" Style="{StaticResource SecondaryText}"
                               Margin="0,7,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                    <Button Content="Add a folder of sounds" Style="{StaticResource PrimaryButton}"
                            Margin="0,18,0,0" HorizontalAlignment="Center"
                            Command="{Binding Settings.AddFolderCommand}"
                            Visibility="{Binding IsEmptyLibrary, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- ============================================================== -->
        <!-- Properties panel                                                -->
        <!-- ============================================================== -->
        <Border Grid.Column="3" Width="356"
                Visibility="{Binding ShowProperties, Converter={StaticResource BoolToVisibility}}">
            <views:PropertiesPanel DataContext="{Binding Properties}"/>
        </Border>
    </Grid>
</UserControl>
