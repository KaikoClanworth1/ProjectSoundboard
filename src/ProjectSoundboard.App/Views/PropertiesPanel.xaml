<UserControl x:Class="ProjectSoundboard.App.Views.PropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ProjectSoundboard.App.Controls"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="Segoe UI" AllowDrop="True">

    <Border Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1,0,0,0">
        <Grid>
            <!-- Nothing selected -->
            <StackPanel VerticalAlignment="Center" Margin="26"
                        Visibility="{Binding HasSound, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="&#xE7C4;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                           HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="Select a sound" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,0"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Its details, artwork and playback settings appear here."
                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSound, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="16,16,16,26">

                    <!-- ==================================================== -->
                    <!-- Artwork + name                                        -->
                    <!-- ==================================================== -->
                    <Grid Height="132">
                        <Border CornerRadius="12" ClipToBounds="True"
                                Background="{Binding Sound.AutoColor, Converter={StaticResource StringToBrush}}">
                            <Grid>
                                <TextBlock Text="{Binding Sound.Initial}" FontSize="46" FontWeight="Bold"
                                           Foreground="White" Opacity="0.92"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Sound.Emoji}" FontSize="52"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding Sound.HasEmoji,
                                                        Converter={StaticResource BoolToVisibility}}"/>
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding Sound.HasThumbnail,
                                                    Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Border>

                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8"
                                CornerRadius="9" Background="#99000000" Padding="4,2">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Width="30" Height="26"
                                        Content="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                        Foreground="White" Command="{Binding ChooseImageCommand}"
                                        ToolTip="Choose an image" AutomationProperties.Name="Choose image"/>
                                <Button Style="{StaticResource IconButton}" Width="30" Height="26"
                                        Content="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                        Foreground="White" Command="{Binding PasteImageCommand}"
                                        ToolTip="Paste an image from the clipboard"
                                        AutomationProperties.Name="Paste image"/>
                                <Button Style="{StaticResource IconButton}" Width="30" Height="26"
                                        Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                        Foreground="White" Command="{Binding RemoveImageCommand}"
                                        ToolTip="Remove the image"
                                        AutomationProperties.Name="Remove image"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="Drop an image here to use it as the tile artwork."
                               Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,0"/>

                    <TextBlock Text="Display name" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=LostFocus}"
                                 AutomationProperties.Name="Display name"/>
                        <Button Grid.Column="1" Content="&#xE777;" FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource IconButton}" Margin="5,0,0,0"
                                Command="{Binding ResetNameCommand}"
                                ToolTip="Reset to the original file name"
                                AutomationProperties.Name="Reset display name"/>
                    </Grid>
                    <TextBlock Text="The file on disk is never renamed — only what you see here."
                               Style="{StaticResource MutedText}" Margin="0,5,0,0" TextWrapping="Wrap"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Emoji" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Emoji, UpdateSourceTrigger=LostFocus}" MaxLength="4"
                                     FontSize="16" HorizontalContentAlignment="Center"
                                     AutomationProperties.Name="Emoji"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Group" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding AvailableGroups}" DisplayMemberPath="Name"
                                      SelectedValuePath="Id" SelectedValue="{Binding SelectedGroupId}"
                                      AutomationProperties.Name="Group"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Tags" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                    <TextBox Text="{Binding TagsText, UpdateSourceTrigger=LostFocus}"
                             ToolTip="Comma separated" AutomationProperties.Name="Tags"/>

                    <TextBlock Text="Keybind" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- No AutomationProperties.Name on the value: it would replace the
                             text, so a screen reader would say "keybind" and never say which
                             key. The label above supplies the context instead. -->
                        <Border Grid.Column="0" Padding="9,6" CornerRadius="6"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                                AutomationProperties.Name="Keybind for this sound">
                            <TextBlock Text="{Binding HotkeyText}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>

                        <Button Grid.Column="1" Content="Change…" Margin="8,0,0,0" Padding="12,6"
                                Command="{Binding SetHotkeyCommand}"
                                ToolTip="Press a key combination to trigger this sound from anywhere"
                                AutomationProperties.Name="Change keybind"/>
                    </Grid>

                    <!-- ==================================================== -->
                    <!-- Transport + waveform                                  -->
                    <!-- ==================================================== -->
                    <Border Style="{StaticResource InlineCard}" Margin="0,16,0,0">
                        <StackPanel>
                            <ctl:WaveformControl x:Name="Waveform" Height="72"
                                                 Waveform="{Binding Waveform}"
                                                 Progress="{Binding Progress}"
                                                 IsLoading="{Binding IsWaveformLoading}"
                                                 TrimStart="{Binding TrimStartSeconds}"
                                                 TrimEnd="{Binding TrimEndSeconds}"
                                                 AutomationProperties.Name="Waveform preview"/>

                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="{Binding PositionText}" Style="{StaticResource MutedText}"/>
                                <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}"
                                           Text="{Binding Sound.DurationSeconds,
                                                  Converter={StaticResource Duration}}"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Padding="12,7"
                                        Command="{Binding PlayEverywhereCommand}"
                                        AutomationProperties.Name="Play everywhere"
                                        ToolTip="Play through the virtual mic and your speakers">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="Play" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="Preview" Margin="6,0,0,0" Padding="12,7"
                                        Command="{Binding PreviewCommand}"
                                        ToolTip="Play to your speakers only — nobody else hears it"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE769;"
                                        FontFamily="Segoe MDL2 Assets" Margin="6,0,0,0"
                                        Command="{Binding PauseResumeCommand}" ToolTip="Pause / resume"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE72C;"
                                        FontFamily="Segoe MDL2 Assets"
                                        Command="{Binding RestartCommand}" ToolTip="Restart"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE71A;"
                                        FontFamily="Segoe MDL2 Assets"
                                        Command="{Binding StopPreviewCommand}" ToolTip="Stop"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ==================================================== -->
                    <!-- Playback settings                                     -->
                    <!-- ==================================================== -->
                    <Grid Margin="0,18,0,6">
                        <TextBlock Text="Playback" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <Button Content="Reset" HorizontalAlignment="Right" Padding="10,3" FontSize="11.5"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding ResetPlaybackSettingsCommand}"/>
                    </Grid>

                    <Grid>
                        <TextBlock Text="Volume" Style="{StaticResource FieldLabel}"/>
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}"
                                   Text="{Binding Volume, Converter={StaticResource Percent}}"/>
                    </Grid>
                    <Slider Minimum="0" Maximum="2" Value="{Binding Volume}" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" AutomationProperties.Name="Sound volume"/>

                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="Speed" Style="{StaticResource FieldLabel}"/>
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}"
                                   Text="{Binding Speed, Converter={StaticResource SpeedText}}"/>
                    </Grid>
                    <Slider Minimum="0.25" Maximum="4" Value="{Binding Speed}" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" AutomationProperties.Name="Playback speed"/>
                    <TextBlock Text="Speed changes pitch too, like a tape." Style="{StaticResource MutedText}"
                               Margin="0,4,0,0"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Fade in (ms)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding FadeInMs, UpdateSourceTrigger=LostFocus}"
                                     AutomationProperties.Name="Fade in milliseconds"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Fade out (ms)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding FadeOutMs, UpdateSourceTrigger=LostFocus}"
                                     AutomationProperties.Name="Fade out milliseconds"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Trim start (s)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding TrimStartSeconds, UpdateSourceTrigger=LostFocus,
                                            StringFormat=0.##}"
                                     AutomationProperties.Name="Trim start seconds"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Trim end (s)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding TrimEndSeconds, UpdateSourceTrigger=LostFocus,
                                            StringFormat=0.##}"
                                     ToolTip="0 means play to the end"
                                     AutomationProperties.Name="Trim end seconds"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Start here" Padding="10,4" FontSize="11.5"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding SetTrimStartHereCommand}"
                                ToolTip="Set trim start to the current preview position"/>
                        <Button Content="End here" Padding="10,4" FontSize="11.5" Margin="4,0,0,0"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding SetTrimEndHereCommand}"/>
                        <Button Content="Clear trim" Padding="10,4" FontSize="11.5" Margin="4,0,0,0"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding ClearTrimCommand}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Loop}"
                                      AutomationProperties.Name="Loop"/>
                        <TextBlock Text="Loop" Margin="9,0,20,0" VerticalAlignment="Center"/>
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Normalize}"
                                      AutomationProperties.Name="Normalise volume"/>
                        <TextBlock Text="Normalise" Margin="9,0,0,0" VerticalAlignment="Center"
                                   ToolTip="Even out loudness against other sounds"/>
                    </StackPanel>

                    <!-- ==================================================== -->
                    <!-- File facts                                            -->
                    <!-- ==================================================== -->
                    <TextBlock Text="File" Style="{StaticResource SectionTitle}" Margin="0,20,0,6"/>

                    <Border Style="{StaticResource InlineCard}">
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style TargetType="TextBlock" x:Key="FactKey" BasedOn="{StaticResource MutedText}">
                                    <Setter Property="Width" Value="86"/>
                                </Style>
                                <Style TargetType="StackPanel" x:Key="FactRow">
                                    <Setter Property="Orientation" Value="Horizontal"/>
                                    <Setter Property="Margin" Value="0,0,0,5"/>
                                </Style>
                            </StackPanel.Resources>

                            <StackPanel Style="{StaticResource FactRow}">
                                <TextBlock Text="Original" Style="{StaticResource FactKey}"/>
                                <TextBlock Text="{Binding Sound.OriginalFileName}" TextWrapping="Wrap"
                                           MaxWidth="200" FontSize="11.5"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FactRow}">
                                <TextBlock Text="Folder" Style="{StaticResource FactKey}"/>
                                <TextBlock Text="{Binding Sound.Directory}" TextWrapping="Wrap"
                                           MaxWidth="200" FontSize="11.5"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FactRow}">
                                <TextBlock Text="Duration" Style="{StaticResource FactKey}"/>
                                <TextBlock FontSize="11.5"
                                           Text="{Binding Sound.DurationSeconds,
                                                  Converter={StaticResource Duration}}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FactRow}">
                                <TextBlock Text="Quality" Style="{StaticResource FactKey}"/>
                                <TextBlock Text="{Binding Sound.QualityText}" FontSize="11.5"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FactRow}">
                                <TextBlock Text="Channels" Style="{StaticResource FactKey}"/>
                                <TextBlock Text="{Binding Sound.ChannelsText}" FontSize="11.5"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FactRow}">
                                <TextBlock Text="Size" Style="{StaticResource FactKey}"/>
                                <TextBlock FontSize="11.5"
                                           Text="{Binding Sound.FileSizeBytes,
                                                  Converter={StaticResource FileSize}}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FactRow}" Margin="0">
                                <TextBlock Text="Played" Style="{StaticResource FactKey}"/>
                                <TextBlock Text="{Binding Sound.PlayCount}" FontSize="11.5"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource DangerBrush}" CornerRadius="9" Padding="11,8"
                            Margin="0,10,0,0"
                            Visibility="{Binding Sound.HasProblem, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Foreground="White" TextWrapping="Wrap" FontSize="11.5"
                                   Text="This file is missing or could not be read. Reconnect the drive or use Settings → Library to repair."/>
                    </Border>

                    <!-- ==================================================== -->
                    <!-- Actions                                               -->
                    <!-- ==================================================== -->
                    <StackPanel Margin="0,16,0,0">
                        <Button Content="Open file location" HorizontalAlignment="Stretch"
                                Command="{Binding OpenLocationCommand}"/>
                        <Button Content="Add to / remove from favourites" HorizontalAlignment="Stretch"
                                Margin="0,6,0,0" Command="{Binding ToggleFavoriteCommand}"/>
                        <Button Content="Rename the file on disk…" HorizontalAlignment="Stretch"
                                Margin="0,6,0,0" Style="{StaticResource GhostButton}"
                                Command="{Binding RenameFileOnDiskCommand}"/>
                        <Button Content="Remove from library" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                Style="{StaticResource DangerButton}"
                                Command="{Binding RemoveFromLibraryCommand}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
