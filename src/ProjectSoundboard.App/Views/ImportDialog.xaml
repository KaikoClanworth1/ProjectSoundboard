<Window x:Class="ProjectSoundboard.App.Views.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Sound(s)"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        SizeToContent="Height" Width="640" MaxHeight="880"
        FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimaryBrush}">

    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Margin="14"
            BorderBrush="{DynamicResource BorderBrushStrong}" BorderThickness="1"
            Effect="{DynamicResource PopupShadow}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="26">

                <TextBlock Text="Import Sound(s)" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="Where would you like to store these sound files?"
                           Style="{StaticResource SecondaryText}" FontSize="13.5" Margin="0,7,0,0"/>

                <!-- Summary of what was dropped -->
                <Border Style="{StaticResource InlineCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock x:Name="SummaryText" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DetailText" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="DuplicateText" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Option 1 -->
                <RadioButton x:Name="OptionCopy" GroupName="Destination" IsChecked="True" Margin="0,16,0,0"
                             AutomationProperties.Name="Import to main sound library">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" CornerRadius="12" Padding="16"
                                    Background="{DynamicResource ElevatedBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="2"
                                    Cursor="Hand">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush"
                                            Value="{DynamicResource BorderBrushStrong}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush"
                                            Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource AccentSoftBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Import to Main Sound Library" FontWeight="SemiBold" FontSize="14.5"/>
                            <Border Background="{DynamicResource SuccessBrush}" CornerRadius="8" Padding="8,2"
                                    Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Recommended" Foreground="White" FontSize="10.5"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,7,0,0"
                                   Text="Copies the files into your sound library folder and adds them straight away. The originals stay exactly where they are, so nothing you dropped is moved or changed."/>
                        <TextBlock x:Name="LibraryPathText" Style="{StaticResource MutedText}" Margin="0,7,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </RadioButton>

                <!-- Option 2 -->
                <RadioButton x:Name="OptionIndex" GroupName="Destination" Margin="0,10,0,0"
                             AutomationProperties.Name="Keep files in their current location">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" CornerRadius="12" Padding="16"
                                    Background="{DynamicResource ElevatedBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="2"
                                    Cursor="Hand">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush"
                                            Value="{DynamicResource BorderBrushStrong}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush"
                                            Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource AccentSoftBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>

                    <StackPanel>
                        <TextBlock Text="Keep Files in Their Current Location" FontWeight="SemiBold" FontSize="14.5"/>
                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,7,0,0"
                                   Text="Nothing is copied or moved — the files are indexed where they already live, and their folder is watched for changes."/>
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,0"
                                   Text="If you later move or delete them outside Project Soundboard, they will show up as missing so you know what happened."/>
                    </StackPanel>
                </RadioButton>

                <!-- Advanced -->
                <Expander Header="Advanced options" Margin="0,16,0,0">
                    <StackPanel Margin="0,8,0,0">
                        <CheckBox x:Name="PreserveStructure" Content="Keep the folder structure when copying"
                                  Margin="0,0,0,10"/>
                        <CheckBox x:Name="AutoTag" Content="Tag new sounds with their folder name"
                                  Margin="0,0,0,10"/>
                        <CheckBox x:Name="DetectDuplicates" Content="Warn me about likely duplicates"/>
                    </StackPanel>
                </Expander>

                <Separator Style="{StaticResource SoftSeparator}" Margin="0,18,0,14"/>

                <CheckBox x:Name="RememberChoice" Content="Always use this option for future imports"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="28,5,0,0" TextWrapping="Wrap"
                           Text="You can change this later in Settings → Library &amp; import."/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Content="Cancel" Width="110" IsCancel="True" Click="OnCancel"/>
                    <Button x:Name="ConfirmButton" Content="Import" Width="130" Margin="8,0,0,0"
                            IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnConfirm"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
