<UserControl x:Class="ProjectSoundboard.App.Views.HotkeysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI"
             Focusable="True">

    <Grid MaxWidth="1000" HorizontalAlignment="Left" Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Hotkeys" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" MaxWidth="720"
                       HorizontalAlignment="Left"
                       Text="These work anywhere in Windows, even while a game has focus. Bind a key to a single sound from the sound's right-click menu, or add general controls here. Everything you have bound is listed below."/>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="9,7" MaxWidth="420" HorizontalAlignment="Left" MinWidth="280"
                         ToolTip="Search by sound, action or key"
                         AutomationProperties.Name="Search keybinds"/>

                <Button Grid.Column="1" Content="Clear" Margin="8,0,0,0" Padding="12,7"
                        Command="{Binding ClearSearchCommand}"
                        Visibility="{Binding SearchText, Converter={StaticResource EmptyStringToVisibility}}"
                        AutomationProperties.Name="Clear keybind search"/>

                <TextBlock Grid.Column="2" Text="{Binding SummaryText}" Margin="14,0,0,0"
                           VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <!-- A key taken from the whole machine is worse than a clash, so it is stated
                 separately and in full rather than folded into the status line. -->
            <!-- The name goes on the Border, not the text: naming the TextBlock replaces
                 what it says, so a screen reader would announce the heading and never read
                 out which keybinds were switched off or why. -->
            <Border Background="{DynamicResource DangerBrush}" CornerRadius="10" Padding="12,9"
                    Margin="0,16,0,0"
                    AutomationProperties.Name="Keybinds switched off"
                    Visibility="{Binding DisabledCount, Converter={StaticResource CountToVisibility}}">
                <TextBlock Text="{Binding DisabledText}" Foreground="White" TextWrapping="Wrap"
                           FontSize="12"/>
            </Border>

            <Border Background="{DynamicResource WarningBrush}" CornerRadius="10" Padding="12,9"
                    Margin="0,16,0,0"
                    Visibility="{Binding ConflictCount, Converter={StaticResource CountToVisibility}}">
                <TextBlock Text="{Binding StatusText}" Foreground="#1A1A1A" TextWrapping="Wrap" FontSize="12"/>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,12" BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource BorderBrushSoft}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Action" Style="{StaticResource FieldLabel}" Margin="0"/>
                        <TextBlock Grid.Column="1" Text="Shortcut" Style="{StaticResource FieldLabel}" Margin="0"/>
                        <TextBlock Grid.Column="2" Text="Enabled" Style="{StaticResource FieldLabel}" Margin="0"/>
                    </Grid>
                </Border>

                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                                Visibility="{Binding Rows.Count, Converter={StaticResource CountToVisibility},
                                             ConverterParameter=invert}">
                        <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="No hotkeys yet" FontSize="15" FontWeight="SemiBold"
                                   Margin="0,12,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,6,0,0"
                                   Text="Add one below, or right-click a sound and choose “Set keybind” to bind a key straight to it."/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}" Padding="0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Padding="16,8" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <ComboBox ItemsSource="{Binding DataContext.Actions,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      SelectedItem="{Binding Action}"
                                                      AutomationProperties.Name="Hotkey action"/>
                                            <TextBlock Text="{Binding ActionText}" Style="{StaticResource MutedText}"
                                                       Margin="2,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" VerticalAlignment="Top" Height="36"
                                                HorizontalContentAlignment="Center"
                                                Content="{Binding KeyText}"
                                                Command="{Binding DataContext.BeginCaptureCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="Change shortcut">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                            <Setter Property="BorderBrush"
                                                                    Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource AccentSoftBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                                            <Setter Property="BorderBrush"
                                                                    Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <ToggleButton Grid.Column="2" Style="{StaticResource Switch}"
                                                      VerticalAlignment="Top" Margin="0,8,0,0"
                                                      IsChecked="{Binding Enabled}"
                                                      AutomationProperties.Name="Hotkey enabled"/>

                                        <Button Grid.Column="3" Style="{StaticResource IconButton}"
                                                VerticalAlignment="Top" Content="&#xE74D;"
                                                FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                Command="{Binding DataContext.RemoveHotkeyCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Remove" AutomationProperties.Name="Remove hotkey"/>
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background"
                                                Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="Set a keybind for a sound…" Style="{StaticResource PrimaryButton}"
                    Command="{Binding AddSoundHotkeyCommand}"
                    ToolTip="Choose a sound, then press the keys that should play it"
                    AutomationProperties.Name="Set a keybind for a sound"/>
            <Button Content="Add a control hotkey" Margin="8,0,0,0"
                    Command="{Binding AddHotkeyCommand}"
                    ToolTip="Stop all, mute, next, and the rest"
                    AutomationProperties.Name="Add a control hotkey"/>
            <Button Content="Cancel capture" Margin="8,0,0,0" Style="{StaticResource GhostButton}"
                    Command="{Binding CancelCaptureCommand}"/>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}"
                       VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Grid>
</UserControl>
