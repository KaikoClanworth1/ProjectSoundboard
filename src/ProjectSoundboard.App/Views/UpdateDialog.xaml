<Window x:Class="ProjectSoundboard.App.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update available"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        SizeToContent="Height" Width="600" MaxHeight="720"
        FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimaryBrush}">

    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Margin="14"
            BorderBrush="{DynamicResource BorderBrushStrong}" BorderThickness="1"
            Effect="{DynamicResource PopupShadow}">
        <StackPanel Margin="26">

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"
                           Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="SubtitleText" Style="{StaticResource SecondaryText}" Margin="0,9,0,0"
                       TextWrapping="Wrap"/>

            <Border Style="{StaticResource InlineCard}" Margin="0,16,0,0" MaxHeight="260">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="12.5" LineHeight="20"/>
                </ScrollViewer>
            </Border>

            <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="Your settings, groups, custom names, artwork and hotkeys are kept — updating only replaces the program files."/>

            <!-- Progress, shown once the download starts -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,16,0,0">
                <ProgressBar x:Name="DownloadProgress" Height="6" Minimum="0" Maximum="1"/>
                <TextBlock x:Name="ProgressText" Style="{StaticResource MutedText}" Margin="0,7,0,0"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="12.5"
                       Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed"/>

            <StackPanel x:Name="ButtonRow" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,22,0,0">
                <Button x:Name="SkipButton" Content="Skip this version" Style="{StaticResource GhostButton}"
                        Padding="12,8" Click="OnSkip"/>
                <Button x:Name="LaterButton" Content="Later" Width="104" Margin="8,0,0,0"
                        IsCancel="True" Click="OnLater"/>
                <Button x:Name="UpdateButton" Content="Update now" MinWidth="140" Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnUpdate"/>
            </StackPanel>

            <Button x:Name="ReleasePageButton" Content="Open the release page instead"
                    HorizontalAlignment="Right" Margin="0,10,0,0" Padding="10,4" FontSize="11.5"
                    Style="{StaticResource GhostButton}" Click="OnOpenReleasePage"/>
        </StackPanel>
    </Border>
</Window>
