<UserControl x:Class="ProjectSoundboard.App.Views.AudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ProjectSoundboard.App.Controls"
             Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <Grid MaxWidth="1000" HorizontalAlignment="Left" Margin="26,22,26,40">
            <StackPanel>

                <TextBlock Text="Audio routing" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" MaxWidth="720"
                           HorizontalAlignment="Left"
                           Text="Sounds go to two places at once: a virtual cable that Discord, VRChat and OBS see as a microphone, and your own headphones so you can hear what you triggered."/>

                <!-- ======================================================= -->
                <!-- Virtual cable warning                                    -->
                <!-- ======================================================= -->
                <!-- ======================================================= -->
                <!-- Virtual cable: install prompt, or what to select where   -->
                <!-- ======================================================= -->
                <Border Style="{StaticResource Card}" Margin="0,18,0,0"
                        BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1.5"
                        Visibility="{Binding HasVirtualCable, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="No virtual audio cable found" FontWeight="SemiBold" FontSize="14.5"
                                       Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,9,0,0"
                                   HorizontalAlignment="Left" MaxWidth="820"
                                   Text="Windows has no built-in way to feed audio into a microphone, so a small free driver does the job. Project Soundboard can fetch VB-CABLE for you: it downloads the official package from VB-Audio, checks the signature, then hands it to Windows to install — you will see the usual administrator prompt."/>

                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   HorizontalAlignment="Left" MaxWidth="820"
                                   Text="VB-CABLE is made by VB-Audio and is free for personal use. Project Soundboard does not bundle or modify it."/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Install VB-CABLE for me" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding InstallVirtualCableCommand}"
                                    IsEnabled="{Binding IsInstallingCable, Converter={StaticResource InverseBool}}"/>
                            <Button Content="Open the download page" Margin="8,0,0,0"
                                    Command="{Binding OpenVirtualCableDownloadCommand}"/>
                            <Button Content="Check again" Margin="8,0,0,0"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding AutoDetectVirtualMicCommand}"/>
                        </StackPanel>

                        <ProgressBar Height="4" Margin="0,14,0,0" IsIndeterminate="True" MaxWidth="360"
                                     HorizontalAlignment="Left"
                                     Visibility="{Binding IsInstallingCable,
                                                  Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock Text="{Binding InstallStatus}" Style="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,10,0,0" HorizontalAlignment="Left"
                                   MaxWidth="820"
                                   Visibility="{Binding InstallStatus,
                                                Converter={StaticResource EmptyStringToVisibility}}"/>
                    </StackPanel>
                </Border>

                <!-- Cable present: tell the user the exact name to type elsewhere -->
                <Border Style="{StaticResource Card}" Margin="0,18,0,0"
                        BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1.5"
                        Visibility="{Binding HasCompanionMicrophone,
                                     Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                            <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                       FontSize="14.5">
                                <Run Text="{Binding CableProduct, Mode=OneWay}"/><Run Text=" is set up"/>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,9,0,0"
                                   HorizontalAlignment="Left" MaxWidth="820"
                                   Text="One step left. In Discord, VRChat, OBS or whatever else you use, choose this as the microphone:"/>

                        <Border Background="{DynamicResource InputBrush}" CornerRadius="9" Padding="14,11"
                                Margin="0,12,0,0" HorizontalAlignment="Left"
                                BorderBrush="{DynamicResource BorderBrushStrong}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CableMicrophoneName}" FontFamily="Consolas"
                                           FontSize="13.5" VerticalAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="560"/>
                                <Button Content="Copy" Margin="16,0,0,0" Padding="12,4" FontSize="11.5"
                                        Command="{Binding CopyMicrophoneNameCommand}"
                                        AutomationProperties.Name="Copy the microphone name"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   HorizontalAlignment="Left" MaxWidth="820"
                                   Text="That name comes from the cable driver, so it is what other applications will show. Inside Project Soundboard the same device is simply called “Project Soundboard Output”."/>
                    </StackPanel>
                </Border>

                <!-- Both outputs on one device: sounds would be heard twice -->
                <Border Style="{StaticResource Card}" Margin="0,18,0,0"
                        BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1.5"
                        Visibility="{Binding OutputsShareDevice,
                                     Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Both outputs are the same device" FontWeight="SemiBold"
                                       FontSize="14.5" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,9,0,0"
                                   HorizontalAlignment="Left" MaxWidth="820"
                                   Text="The virtual microphone and your headphones are set to the same Windows device. Sounds are being played once instead of twice to avoid the hollow, echoey “in a cave” effect that two overlapping copies produce."/>
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   HorizontalAlignment="Left" MaxWidth="820"
                                   Text="This is what happens when no virtual audio cable is installed. Install one and set it as the virtual microphone, and your friends will hear the soundboard while you keep your headphones for yourself."/>
                    </StackPanel>
                </Border>

                <!-- ======================================================= -->
                <!-- Devices                                                  -->
                <!-- ======================================================= -->
                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="Outputs" Style="{StaticResource SectionTitle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Virtual mic -->
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ToggleButton Style="{StaticResource Switch}"
                                                  IsChecked="{Binding VirtualMicEnabled}"
                                                  AutomationProperties.Name="Enable virtual microphone output"/>
                                    <TextBlock Text="{Binding VirtualMicDisplayName}" Margin="9,0,0,0"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                                    <Ellipse Width="8" Height="8" Margin="9,0,0,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VirtualMicRunning}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </StackPanel>

                                <ComboBox ItemsSource="{Binding OutputDevices}"
                                          SelectedItem="{Binding VirtualMicDevice}"
                                          IsEnabled="{Binding VirtualMicEnabled}"
                                          AutomationProperties.Name="Virtual microphone device">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="10" VerticalAlignment="Center"
                                                           Margin="0,0,7,0"
                                                           Foreground="{DynamicResource SuccessBrush}"
                                                           Visibility="{Binding IsVirtualCable,
                                                                        Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding IsAliased,
                                                        Converter={StaticResource InverseBoolToVisibility}}"
                                           Text="Pick your virtual cable's playback device here. Its name will look inverted — VB-CABLE calls its playback half “CABLE Input”."/>

                                <!-- When aliased, say plainly which real device is behind our label. -->
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding IsAliased, Converter={StaticResource BoolToVisibility}}">
                                    <Run Text="Shown as “Project Soundboard Output” elsewhere in the app. Windows knows it as"/>
                                    <Run Text="{Binding VirtualMicRealName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="."/>
                                </TextBlock>

                                <Grid Margin="0,12,0,0">
                                    <TextBlock Text="Level" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}"
                                               Text="{Binding VirtualMicVolume, Converter={StaticResource Percent}}"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="1.5" Value="{Binding VirtualMicVolume}"
                                        AutomationProperties.Name="Virtual microphone volume"/>

                                <ctl:LevelMeterControl Height="14" Margin="0,10,0,0" ShowScale="True"
                                                       Peak="{Binding VirtualMicPeak}"
                                                       Rms="{Binding VirtualMicRms}"
                                                       PeakHold="{Binding VirtualMicHold}"
                                                       AutomationProperties.Name="Virtual microphone level meter"/>
                            </StackPanel>

                            <!-- Monitor -->
                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ToggleButton Style="{StaticResource Switch}"
                                                  IsChecked="{Binding MonitorEnabled}"
                                                  AutomationProperties.Name="Enable monitor output"/>
                                    <TextBlock Text="Your headphones" Margin="9,0,0,0" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Ellipse Width="8" Height="8" Margin="9,0,0,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MonitorRunning}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </StackPanel>

                                <ComboBox ItemsSource="{Binding OutputDevices}"
                                          SelectedItem="{Binding MonitorDevice}"
                                          DisplayMemberPath="Name"
                                          IsEnabled="{Binding MonitorEnabled}"
                                          AutomationProperties.Name="Monitor device"/>

                                <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="Only you hear this one. Turn it down if the soundboard drowns out the game."/>

                                <Grid Margin="0,12,0,0">
                                    <TextBlock Text="Level" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}"
                                               Text="{Binding MonitorVolume, Converter={StaticResource Percent}}"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="1.5" Value="{Binding MonitorVolume}"
                                        AutomationProperties.Name="Monitor volume"/>

                                <ctl:LevelMeterControl Height="14" Margin="0,10,0,0" ShowScale="True"
                                                       Peak="{Binding MonitorPeak}"
                                                       Rms="{Binding MonitorRms}"
                                                       PeakHold="{Binding MonitorHold}"
                                                       AutomationProperties.Name="Monitor level meter"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="Detect virtual cable"
                                    Command="{Binding AutoDetectVirtualMicCommand}"/>
                            <Button Content="Restart audio engine" Margin="8,0,0,0"
                                    Command="{Binding RestartAudioCommand}"/>
                            <Button Content="Windows sound settings" Margin="8,0,0,0"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding OpenSoundControlPanelCommand}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding StatusText, Converter={StaticResource EmptyStringToVisibility}}"/>

                        <Border Background="{DynamicResource DangerBrush}" CornerRadius="9" Padding="11,8"
                                Margin="0,10,0,0"
                                Visibility="{Binding ErrorText, Converter={StaticResource EmptyStringToVisibility}}">
                            <TextBlock Text="{Binding ErrorText}" Foreground="White" TextWrapping="Wrap"
                                       FontSize="12"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ======================================================= -->
                <!-- Latency                                                  -->
                <!-- ======================================================= -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Latency and buffering" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <Border HorizontalAlignment="Right" Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="9" Padding="10,4">
                                <TextBlock Text="{Binding LatencyText}" FontWeight="SemiBold" FontSize="12"/>
                            </Border>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding LowLatencyMode}"
                                          AutomationProperties.Name="Low latency mode"/>
                            <StackPanel Margin="9,0,0,0">
                                <TextBlock Text="Low latency mode" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" MaxWidth="640"
                                           Text="Smallest safe buffer, best for voice chat. Turn it off if you hear crackling — some USB interfaces need more headroom."/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Grid>
                                    <TextBlock Text="Buffer size" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}">
                                        <Run Text="{Binding BufferSizeMs}"/><Run Text=" ms"/>
                                    </TextBlock>
                                </Grid>
                                <Slider Minimum="5" Maximum="200" Value="{Binding BufferSizeMs}"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        AutomationProperties.Name="Buffer size in milliseconds"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Lower is snappier; too low and you get pops. 10–30 ms suits most machines."/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Sample rate" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding SampleRates}" SelectedItem="{Binding SampleRate}"
                                          AutomationProperties.Name="Sample rate"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="48 000 Hz matches what Windows and voice apps use — leave it there unless you have a reason."/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ======================================================= -->
                <!-- Master processing                                        -->
                <!-- ======================================================= -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Master processing" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <Button Content="Reset" HorizontalAlignment="Right" Padding="11,4" FontSize="11.5"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding ResetProcessingCommand}"/>
                        </Grid>

                        <!-- Limiter -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding LimiterEnabled}"
                                          AutomationProperties.Name="Limiter"/>
                            <StackPanel Margin="9,0,0,0">
                                <TextBlock Text="Limiter (recommended)" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" MaxWidth="640"
                                           Text="Stops loud sounds from clipping into the voice chat. This is what keeps a soundboard from sounding like static."/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,10,0,0" IsEnabled="{Binding LimiterEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <Grid>
                                    <TextBlock Text="Ceiling" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}"
                                               Text="{Binding LimiterThresholdDb, Converter={StaticResource Decibels}}"/>
                                </Grid>
                                <Slider Minimum="-12" Maximum="0" Value="{Binding LimiterThresholdDb}"
                                        TickFrequency="0.5" IsSnapToTickEnabled="True"
                                        AutomationProperties.Name="Limiter ceiling"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Gain reduction" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Style="{StaticResource SecondaryText}" FontWeight="SemiBold"
                                           Text="{Binding LimiterReductionDb, Converter={StaticResource Decibels}}"/>
                            </StackPanel>
                        </Grid>

                        <Separator Style="{StaticResource SoftSeparator}"/>

                        <!-- Compressor -->
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding CompressorEnabled}"
                                          AutomationProperties.Name="Compressor"/>
                            <StackPanel Margin="9,0,0,0">
                                <TextBlock Text="Compressor" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" MaxWidth="640"
                                           Text="Evens out sounds that were recorded at wildly different volumes."/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,12,0,0" IsEnabled="{Binding CompressorEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <Grid>
                                    <TextBlock Text="Threshold" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}"
                                               Text="{Binding CompressorThresholdDb, Converter={StaticResource Decibels}}"/>
                                </Grid>
                                <Slider Minimum="-48" Maximum="0" Value="{Binding CompressorThresholdDb}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <Grid>
                                    <TextBlock Text="Ratio" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}">
                                        <Run Text="{Binding CompressorRatio, StringFormat=0.#}"/><Run Text=" : 1"/>
                                    </TextBlock>
                                </Grid>
                                <Slider Minimum="1" Maximum="20" Value="{Binding CompressorRatio}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                                <Grid>
                                    <TextBlock Text="Attack" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}">
                                        <Run Text="{Binding CompressorAttackMs, StringFormat=0}"/><Run Text=" ms"/>
                                    </TextBlock>
                                </Grid>
                                <Slider Minimum="1" Maximum="200" Value="{Binding CompressorAttackMs}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
                                <Grid>
                                    <TextBlock Text="Release" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}">
                                        <Run Text="{Binding CompressorReleaseMs, StringFormat=0}"/><Run Text=" ms"/>
                                    </TextBlock>
                                </Grid>
                                <Slider Minimum="20" Maximum="1000" Value="{Binding CompressorReleaseMs}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,10,0,0">
                                <Grid>
                                    <TextBlock Text="Make-up gain" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}"
                                               Text="{Binding CompressorMakeupDb, Converter={StaticResource Decibels}}"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="18" Value="{Binding CompressorMakeupDb}"/>
                            </StackPanel>
                        </Grid>

                        <Separator Style="{StaticResource SoftSeparator}"/>

                        <!-- EQ -->
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding EqEnabled}"
                                          AutomationProperties.Name="Equaliser"/>
                            <TextBlock Text="Equaliser" Margin="9,0,0,0" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding EqBands}" Margin="0,12,0,0"
                                      IsEnabled="{Binding EqEnabled}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center" Margin="6,0">
                                        <TextBlock Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                                                   Text="{Binding GainDb, Converter={StaticResource Decibels}}"/>
                                        <Slider Orientation="Vertical" Height="110" Minimum="-18" Maximum="18"
                                                Value="{Binding GainDb}" HorizontalAlignment="Center"
                                                Margin="0,6" AutomationProperties.Name="{Binding Name}"/>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource MutedText}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ======================================================= -->
                <!-- App setup help                                           -->
                <!-- ======================================================= -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Setting up your voice app" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   HorizontalAlignment="Left" MaxWidth="820"
                                   Text="Whatever you use, the pattern is the same: Project Soundboard plays into the cable, and the app listens to the cable instead of your real microphone."/>

                        <TextBlock Text="{Binding VoiceAppInstruction}" Style="{StaticResource BodyText}"
                                   TextWrapping="Wrap" Margin="0,8,0,12" HorizontalAlignment="Left"
                                   MaxWidth="820" FontWeight="SemiBold"/>

                        <ItemsControl>
                            <ItemsControl.Resources>
                                <Style TargetType="TextBlock" x:Key="AppName">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Width" Value="160"/>
                                </Style>
                            </ItemsControl.Resources>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <TextBlock Text="Discord" Style="{StaticResource AppName}"/>
                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" MaxWidth="620"
                                           Text="Settings → Voice &amp; Video → Input device. Then turn Noise Suppression, Echo Cancellation and Automatic Gain Control off, or they will chew up your sounds."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <TextBlock Text="VRChat" Style="{StaticResource AppName}"/>
                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" MaxWidth="620"
                                           Text="Settings → Audio &amp; Voice → Microphone. Leave VRChat's own gain near the middle."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <TextBlock Text="OBS Studio" Style="{StaticResource AppName}"/>
                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" MaxWidth="620"
                                           Text="Add an Audio Input Capture source and point it at the same device."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Steam / TS / Mumble" Style="{StaticResource AppName}"/>
                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" MaxWidth="620"
                                           Text="Choose it wherever the app lists microphones, and disable any built-in noise gate."/>
                            </StackPanel>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   HorizontalAlignment="Left" MaxWidth="820"
                                   Text="Want people to hear you as well as the sounds? Turn on microphone passthrough on the Mic page — then the cable carries both and you only need one device selected."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
