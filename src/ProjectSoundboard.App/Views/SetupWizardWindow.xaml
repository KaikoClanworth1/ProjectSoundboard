<Window x:Class="ProjectSoundboard.App.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:ProjectSoundboard.App.Controls"
        Title="Welcome to Project Soundboard"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Width="860" Height="660" FontFamily="Segoe UI"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="16" Margin="12"
            BorderBrush="{DynamicResource BorderBrushStrong}" BorderThickness="1"
            Effect="{DynamicResource PopupShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="30,22,30,16" MouseLeftButtonDown="OnHeaderDrag">
                <Grid>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="26" Height="26" CornerRadius="8"
                                    Background="{DynamicResource AccentBrush}">
                                <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{DynamicResource TextOnAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Project Soundboard setup" FontWeight="SemiBold" FontSize="14"
                                       Margin="11,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <ProgressBar Width="300" Height="5" Minimum="0" Maximum="1"
                                         Value="{Binding ProgressFraction, Mode=OneWay}"
                                         VerticalAlignment="Center"/>
                            <TextBlock Margin="12,0,0,0" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center">
                                <Run Text="Step"/>
                                <Run Text="{Binding StepNumber, Mode=OneWay}"/>
                                <Run Text="of"/>
                                <Run Text="{Binding StepCount, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE8BB;"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Click="OnCloseClick" AutomationProperties.Name="Cancel setup"/>
                </Grid>
            </Border>

            <!-- Steps -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30,0,30,10">
                <Grid>

                    <!-- ================== Welcome ================== -->
                    <StackPanel Visibility="{Binding Step, Converter={StaticResource EqualsToVisibility},
                                             ConverterParameter=Welcome}">
                        <TextBlock Text="Let's get you set up" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" FontSize="13.5"
                                   Text="Project Soundboard plays your sounds into voice chat as if they came from your microphone. This takes about a minute, and every choice can be changed later."/>

                        <ItemsControl Margin="0,22,0,0">
                            <Border Style="{StaticResource InlineCard}" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"/>
                                    <StackPanel Margin="14,0,0,0">
                                        <TextBlock Text="Point at your folders" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                                   MaxWidth="620"
                                                   Text="No importing files one by one. Choose the folders your sounds already live in and they all appear, including anything you add later."/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InlineCard}" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"/>
                                    <StackPanel Margin="14,0,0,0">
                                        <TextBlock Text="Two outputs at once" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                                   MaxWidth="620"
                                                   Text="Sounds go to a virtual microphone your friends hear, and to your own headphones so you know what you triggered."/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InlineCard}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"/>
                                    <StackPanel Margin="14,0,0,0">
                                        <TextBlock Text="Global hotkeys" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                                   MaxWidth="620"
                                                   Text="Trigger sounds without leaving your game. Nothing needs to be in focus."/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ================== Theme ================== -->
                    <StackPanel Visibility="{Binding Step, Converter={StaticResource EqualsToVisibility},
                                             ConverterParameter=Theme}">
                        <TextBlock Text="Pick a look" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   Text="Try them — the window updates as you choose."/>

                        <UniformGrid Columns="2" Margin="0,20,0,0">
                            <Button Margin="0,0,8,0" Height="150" Command="{Binding ChooseThemeCommand}"
                                    CommandParameter="Dark" AutomationProperties.Name="Dark theme">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="12" BorderThickness="2" Cursor="Hand"
                                                Background="#12151C"
                                                BorderBrush="{DynamicResource BorderBrushSoft}">
                                            <StackPanel VerticalAlignment="Center">
                                                <Border Width="150" Height="10" CornerRadius="5" Background="#6C8CFF"
                                                        HorizontalAlignment="Center"/>
                                                <Border Width="110" Height="10" CornerRadius="5" Background="#2A2F3A"
                                                        HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                <Border Width="130" Height="10" CornerRadius="5" Background="#2A2F3A"
                                                        HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                <TextBlock Text="Dark" Foreground="#E7EAF0" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" Margin="0,18,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Theme}" Value="Dark">
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Margin="8,0,0,0" Height="150" Command="{Binding ChooseThemeCommand}"
                                    CommandParameter="Light" AutomationProperties.Name="Light theme">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="12" BorderThickness="2" Cursor="Hand"
                                                Background="#FFFFFF"
                                                BorderBrush="{DynamicResource BorderBrushSoft}">
                                            <StackPanel VerticalAlignment="Center">
                                                <Border Width="150" Height="10" CornerRadius="5" Background="#3B62E8"
                                                        HorizontalAlignment="Center"/>
                                                <Border Width="110" Height="10" CornerRadius="5" Background="#DDE1E8"
                                                        HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                <Border Width="130" Height="10" CornerRadius="5" Background="#DDE1E8"
                                                        HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                <TextBlock Text="Light" Foreground="#111520" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" Margin="0,18,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Theme}" Value="Light">
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </UniformGrid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Match Windows" Command="{Binding ChooseThemeCommand}"
                                    CommandParameter="System"/>
                            <Button Content="High contrast" Margin="8,0,0,0"
                                    Command="{Binding ChooseThemeCommand}" CommandParameter="HighContrast"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ================== Folders ================== -->
                    <StackPanel Visibility="{Binding Step, Converter={StaticResource EqualsToVisibility},
                                             ConverterParameter=Folders}">
                        <TextBlock Text="Where are your sounds?" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   Text="Choose one or more folders. Everything inside them, including subfolders, becomes part of your library — and stays in sync as you add or remove files."/>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Folders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" Margin="11,0"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                        Width="28" Height="28" Content="&#xE74D;"
                                                        FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                        Command="{Binding DataContext.RemoveFolderCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="Remove folder"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                           Visibility="{Binding HasFolders,
                                                        Converter={StaticResource InverseBoolToVisibility}}"
                                           Text="No folders yet. If you skip this you can always drag files onto the window later."/>

                                <Button Content="Add a folder" Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Command="{Binding AddFolderCommand}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Main sound library" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                           Text="When you drag files in later, this is where Project Soundboard offers to copy them so they never go missing."/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBox Text="{Binding MainLibraryPath}" Width="460"
                                             AutomationProperties.Name="Main sound library folder"/>
                                    <Button Content="Browse…" Margin="8,0,0,0"
                                            Command="{Binding ChooseMainLibraryCommand}"/>
                                </StackPanel>
                                <Button Content="Use the suggested folder" HorizontalAlignment="Left"
                                        Margin="0,8,0,0" Style="{StaticResource GhostButton}"
                                        Command="{Binding UseSuggestedLibraryCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================== Virtual mic ================== -->
                    <StackPanel Visibility="{Binding Step, Converter={StaticResource EqualsToVisibility},
                                             ConverterParameter=VirtualMic}">
                        <TextBlock Text="The virtual microphone" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   Text="Windows cannot feed audio into a microphone on its own, so a small free driver acts as a cable: Project Soundboard plays into one end, and your voice app listens to the other."/>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0"
                                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1.5"
                                Visibility="{Binding HasVirtualCable,
                                             Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="No virtual cable installed yet" FontWeight="SemiBold"
                                           FontSize="14"/>
                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Text="Project Soundboard can fetch VB-CABLE for you — it downloads the official package from VB-Audio, checks the signature, then hands it to Windows, so you will see the normal administrator prompt. You can also skip this: the soundboard will still play to your own speakers, it just will not reach voice chat."/>
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Text="VB-CABLE is made by VB-Audio and is free for personal use. Project Soundboard does not bundle or modify it."/>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Install it for me" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding InstallVirtualCableCommand}"
                                            IsEnabled="{Binding IsInstallingCable,
                                                        Converter={StaticResource InverseBool}}"/>
                                    <Button Content="Download page" Margin="8,0,0,0"
                                            Command="{Binding OpenVirtualCableDownloadCommand}"/>
                                    <Button Content="Check again" Margin="8,0,0,0"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding RefreshDevicesCommand}"/>
                                </StackPanel>

                                <ProgressBar Height="4" Margin="0,14,0,0" IsIndeterminate="True"
                                             HorizontalAlignment="Left" Width="300"
                                             Visibility="{Binding IsInstallingCable,
                                                          Converter={StaticResource BoolToVisibility}}"/>

                                <TextBlock Text="{Binding InstallStatus}" Style="{StaticResource SecondaryText}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="{Binding InstallStatus,
                                                        Converter={StaticResource EmptyStringToVisibility}}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Send sounds to" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding OutputDevices}"
                                          SelectedItem="{Binding VirtualMicDevice}" DisplayMemberPath="Name"
                                          AutomationProperties.Name="Virtual microphone device"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,7,0,0" TextWrapping="Wrap"
                                           Text="Usually called “CABLE Input”. In Discord or VRChat you then pick the matching “CABLE Output” as your microphone."/>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding LowLatencyMode}"/>
                                    <StackPanel Margin="9,0,0,0">
                                        <TextBlock Text="Low latency mode" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                   MaxWidth="560"
                                                   Text="Recommended for voice chat. Turn it off later if you hear crackling."/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================== Monitor ================== -->
                    <StackPanel Visibility="{Binding Step, Converter={StaticResource EqualsToVisibility},
                                             ConverterParameter=Monitor}">
                        <TextBlock Text="What you hear" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   Text="Sounds are also played to your own headphones so you can tell what you triggered. Only you hear this one."/>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Your headphones or speakers" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding OutputDevices}"
                                          SelectedItem="{Binding MonitorDevice}" DisplayMemberPath="Name"
                                          AutomationProperties.Name="Monitor device"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,7,0,0" TextWrapping="Wrap"
                                           Text="Pick the device you actually listen through — not the virtual cable, or you will not hear anything."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================== Microphone ================== -->
                    <StackPanel Visibility="{Binding Step, Converter={StaticResource EqualsToVisibility},
                                             ConverterParameter=Microphone}">
                        <TextBlock Text="Your microphone" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   Text="Passthrough mixes your voice into the same virtual cable, so your voice app only needs one microphone selected and hears both you and your sounds."/>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Microphone" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding InputDevice}"
                                          DisplayMemberPath="Name"
                                          AutomationProperties.Name="Microphone device"/>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <ToggleButton Style="{StaticResource Switch}"
                                                  IsChecked="{Binding PassthroughEnabled}"/>
                                    <StackPanel Margin="9,0,0,0">
                                        <TextBlock Text="Mix my voice into the virtual microphone"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                   MaxWidth="580"
                                                   Text="Leave this on unless you would rather keep your real microphone selected in your voice app and use a second one for sounds."/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Style="{StaticResource MutedText}" Margin="0,14,0,0" TextWrapping="Wrap"
                                           Text="A noise gate is on by default, so keyboard clatter will not carry. You can tune it, or turn it off, on the Mic page."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================== Voice apps ================== -->
                    <StackPanel Visibility="{Binding Step, Converter={StaticResource EqualsToVisibility},
                                             ConverterParameter=VoiceApps}">
                        <TextBlock Text="Setting up Discord, VRChat and friends"
                                   Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   Text="One change in each app and you are done. Point its microphone at the cable instead of your real mic."/>

                        <!-- The exact string to look for, shown only once we actually know it -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                                Visibility="{Binding HasCompanionMicrophone,
                                             Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Look for this device" Style="{StaticResource FieldLabel}"/>
                                <Border Background="{DynamicResource InputBrush}" CornerRadius="9"
                                        Padding="14,11" HorizontalAlignment="Left"
                                        BorderBrush="{DynamicResource BorderBrushStrong}" BorderThickness="1">
                                    <TextBlock Text="{Binding CableMicrophoneName}" FontFamily="Consolas"
                                               FontSize="13.5" TextWrapping="Wrap" MaxWidth="640"/>
                                </Border>
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,9,0,0"
                                           Text="That name comes from the cable driver, so it is what other applications show. Inside Project Soundboard the same device is just called “Project Soundboard Output”."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Discord" FontWeight="SemiBold" FontSize="13.5"/>
                                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                               Margin="0,4,0,0">
                                        <Run Text="Settings → Voice &amp; Video → Input device."/>
                                        <Run Text="{Binding VoiceAppInstruction, Mode=OneWay}"/>
                                        <Run Text="Then turn off Noise Suppression, Echo Cancellation and Automatic Gain Control — they are tuned for speech and will mangle sound effects."/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="VRChat" FontWeight="SemiBold" FontSize="13.5"/>
                                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                               Margin="0,4,0,0">
                                        <Run Text="Settings → Audio &amp; Voice → Microphone."/>
                                        <Run Text="{Binding VoiceAppInstruction, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="OBS Studio" FontWeight="SemiBold" FontSize="13.5"/>
                                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               Text="Add an Audio Input Capture source pointed at the same device to capture the soundboard on stream."/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Steam, TeamSpeak, Mumble, in-game chat" FontWeight="SemiBold"
                                               FontSize="13.5"/>
                                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               Text="Wherever the app lists microphones, choose the same device. Disable any built-in noise gate or voice activity filter for the best results."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================== Hotkeys ================== -->
                    <StackPanel Visibility="{Binding Step, Converter={StaticResource EqualsToVisibility},
                                             ConverterParameter=Hotkeys}">
                        <TextBlock Text="Hotkeys" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   Text="These work everywhere in Windows, so you can trigger sounds without leaving your game."/>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource Switch}"
                                                  IsChecked="{Binding EnableDefaultHotkeys}"/>
                                    <TextBlock Text="Set up a few sensible defaults" Margin="9,0,0,0"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Border Background="{DynamicResource InputBrush}" CornerRadius="9" Padding="14"
                                        Margin="0,14,0,0">
                                    <TextBlock Text="{Binding DefaultHotkeyDescription}" LineHeight="22"
                                               FontSize="12.5"/>
                                </Border>

                                <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0" TextWrapping="Wrap"
                                           Text="To bind a key to one specific sound, right-click that sound later and choose “Assign a hotkey”. Anything already taken by another app is flagged so you know to pick something else."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================== Test ================== -->
                    <StackPanel Visibility="{Binding Step, Converter={StaticResource EqualsToVisibility},
                                             ConverterParameter=Test}">
                        <TextBlock Text="Let's test it" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   Text="Your choices are live now. Play something and watch the meters — the top one is what other people will hear."/>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Play a test sound" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding PlayTestToneCommand}"/>
                                    <Button Content="Stop" Margin="8,0,0,0" Command="{Binding StopTestCommand}"/>
                                </StackPanel>

                                <TextBlock Text="{Binding TestResultText}" Style="{StaticResource SecondaryText}"
                                           TextWrapping="Wrap" Margin="0,14,0,0"
                                           Visibility="{Binding TestRan, Converter={StaticResource BoolToVisibility}}"/>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Virtual microphone" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Center"/>
                                    <ctl:LevelMeterControl Grid.Column="1" Height="14" Margin="0,5"
                                                           Peak="{Binding TestVirtualPeak}"/>

                                    <TextBlock Grid.Row="1" Text="Your headphones"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <ctl:LevelMeterControl Grid.Row="1" Grid.Column="1" Height="14" Margin="0,5"
                                                           Peak="{Binding TestMonitorPeak}"/>

                                    <TextBlock Grid.Row="2" Text="Your microphone"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <ctl:LevelMeterControl Grid.Row="2" Grid.Column="1" Height="14" Margin="0,5"
                                                           Peak="{Binding TestMicPeak}"/>
                                </Grid>

                                <TextBlock Style="{StaticResource MutedText}" Margin="0,14,0,0" TextWrapping="Wrap"
                                           Text="Nothing moving on the virtual microphone meter? Go back a couple of steps and check the device choice. Nothing on your microphone? Try speaking, or pick a different input device."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================== Finish ================== -->
                    <StackPanel Visibility="{Binding Step, Converter={StaticResource EqualsToVisibility},
                                             ConverterParameter=Finish}">
                        <TextBlock Text="You're all set" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   Text="Project Soundboard is ready. Here is what to do next."/>

                        <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="Drag sounds straight onto the window" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                           Margin="0,4,0,14"
                                           Text="Files or whole folders. You choose whether to copy them into your library or leave them where they are."/>

                                <TextBlock Text="Rename anything you like" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                           Margin="0,4,0,14"
                                           Text="Display names, artwork, emoji and tags are stored inside the app. Your actual files are never touched."/>

                                <TextBlock Text="Set your voice app's microphone to the cable" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Text="If you skipped that step, the instructions are on the Audio page whenever you need them."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="30,16,30,24" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderBrushSoft}">
                <Grid>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Left"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Back" Width="104" Click="OnBack"
                                IsEnabled="{Binding CanGoBack}"/>
                        <Button Content="{Binding NextButtonText}" MinWidth="150" Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButton}" Click="OnNext" IsDefault="True"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
