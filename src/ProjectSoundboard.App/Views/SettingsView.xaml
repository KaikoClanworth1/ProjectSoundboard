<UserControl x:Class="ProjectSoundboard.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="CategoryButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Padding="11,8" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One labelled switch row -->
        <Style x:Key="SettingRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Category rail -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,14">
                    <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="14" Margin="17,0,0,10"/>
                    <RadioButton Style="{StaticResource CategoryButton}" Content="General"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool},
                                             ConverterParameter=General, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource CategoryButton}" Content="Appearance"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool},
                                             ConverterParameter=Appearance, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource CategoryButton}" Content="Playback"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool},
                                             ConverterParameter=Playback, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource CategoryButton}" Content="Library &amp; import"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool},
                                             ConverterParameter=Library, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource CategoryButton}" Content="Search"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool},
                                             ConverterParameter=Search, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource CategoryButton}" Content="Performance"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool},
                                             ConverterParameter=Performance, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource CategoryButton}" Content="Notifications"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool},
                                             ConverterParameter=Notifications, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource CategoryButton}" Content="Accessibility"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool},
                                             ConverterParameter=Accessibility, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource CategoryButton}" Content="Backup &amp; restore"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool},
                                             ConverterParameter=Backup, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource CategoryButton}" Content="Advanced"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool},
                                             ConverterParameter=Advanced, Mode=TwoWay}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="880" HorizontalAlignment="Left" Margin="26,22,26,40">
                <StackPanel>

                    <!-- ================================================== -->
                    <!-- General                                             -->
                    <!-- ================================================== -->
                    <StackPanel Visibility="{Binding Section, Converter={StaticResource EqualsToVisibility},
                                             ConverterParameter=General}">
                        <TextBlock Text="General" Style="{StaticResource PageTitle}"/>
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}"
                                                  IsChecked="{Binding StartWithWindows}"/>
                                    <StackPanel Margin="9,0,0,0">
                                        <TextBlock Text="Start with Windows" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource MutedText}"
                                                   Text="Adds an entry under your account's startup programs."/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding StartMinimized}"/>
                                    <TextBlock Text="Start minimised" Margin="9,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding MinimizeToTray}"/>
                                    <StackPanel Margin="9,0,0,0">
                                        <TextBlock Text="Hide to the tray when minimised"/>
                                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                   MaxWidth="620"
                                                   Text="Off by default: minimising puts Project Soundboard on the taskbar like any other program. Turn this on to have it disappear into the tray instead."/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding CloseToTray}"/>
                                    <TextBlock Text="Closing the window keeps it running in the tray"
                                               Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding ConfirmOnDelete}"/>
                                    <TextBlock Text="Ask before removing sounds from the library" Margin="9,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}" Margin="0">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding CheckForUpdates}"/>
                                    <TextBlock Text="Check for updates" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Updates" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding AppVersionText}" Style="{StaticResource SecondaryText}"/>
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="Updates are downloaded from GitHub and replace only the program files — your settings, groups, artwork and hotkeys are kept."/>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Check for updates now"
                                            Command="{Binding CheckForUpdatesNowCommand}"
                                            IsEnabled="{Binding IsCheckingForUpdates,
                                                        Converter={StaticResource InverseBool}}"/>
                                    <Button Content="Release notes" Margin="8,0,0,0"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding OpenReleasesPageCommand}"/>
                                </StackPanel>

                                <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource SecondaryText}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="{Binding UpdateStatus,
                                                        Converter={StaticResource EmptyStringToVisibility}}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Where your data lives" Style="{StaticResource SectionTitle}"
                                               Margin="0"/>
                                    <Border Background="{DynamicResource SuccessBrush}" CornerRadius="8"
                                            Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsPortable,
                                                         Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Portable" Foreground="White" FontSize="10.5"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding DataLocationText}" Style="{StaticResource SecondaryText}"
                                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="Your actual sound files are never moved — the library only stores paths to them."/>

                                <Button Content="Open data folder" HorizontalAlignment="Left" Margin="0,12,0,0"
                                        Command="{Binding OpenDataFolderCommand}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="First-run setup" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                           Text="Run through the guided setup again to re-pick your folders, devices and hotkeys."/>
                                <Button Content="Run the setup wizard" HorizontalAlignment="Left" Margin="0,12,0,0"
                                        Command="{Binding RunSetupWizardCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================== -->
                    <!-- Appearance                                          -->
                    <!-- ================================================== -->
                    <StackPanel Visibility="{Binding Section, Converter={StaticResource EqualsToVisibility},
                                             ConverterParameter=Appearance}">
                        <TextBlock Text="Appearance" Style="{StaticResource PageTitle}"/>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Theme" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"
                                          Width="240" HorizontalAlignment="Left"/>

                                <TextBlock Text="Accent colour" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                                <ItemsControl ItemsSource="{Binding AccentPresets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="34" Height="34" Margin="0,0,8,0" Cursor="Hand"
                                                    Command="{Binding DataContext.SetAccentCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="9" BorderThickness="2"
                                                                BorderBrush="{DynamicResource BorderBrushStrong}"
                                                                Background="{Binding Converter={StaticResource StringToBrush}}"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBox Text="{Binding AccentColor, UpdateSourceTrigger=LostFocus}" Width="120"
                                             AutomationProperties.Name="Accent colour hex"/>
                                    <Border Width="34" Height="34" CornerRadius="9" Margin="8,0,0,0"
                                            Background="{Binding AccentColor, Converter={StaticResource StringToBrush}}"
                                            BorderBrush="{DynamicResource BorderBrushStrong}" BorderThickness="1"/>
                                </StackPanel>

                                <Separator Style="{StaticResource SoftSeparator}"/>

                                <Grid>
                                    <TextBlock Text="Interface scale" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}"
                                               Text="{Binding UiScale, Converter={StaticResource Percent}}"/>
                                </Grid>
                                <Slider Minimum="0.75" Maximum="1.75" Value="{Binding UiScale}"
                                        TickFrequency="0.05" IsSnapToTickEnabled="True" MaxWidth="420"
                                        HorizontalAlignment="Left" AutomationProperties.Name="Interface scale"/>

                                <StackPanel Style="{StaticResource SettingRow}" Margin="0,18,0,14">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding EnableAnimations}"/>
                                    <TextBlock Text="Animations" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding ShowSoundImages}"/>
                                    <TextBlock Text="Show artwork on sound tiles" Margin="9,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}" Margin="0">
                                    <ToggleButton Style="{StaticResource Switch}"
                                                  IsChecked="{Binding ShowWaveformInPanel}"/>
                                    <TextBlock Text="Show the waveform in the details panel" Margin="9,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================== -->
                    <!-- Playback                                            -->
                    <!-- ================================================== -->
                    <StackPanel Visibility="{Binding Section, Converter={StaticResource EqualsToVisibility},
                                             ConverterParameter=Playback}">
                        <TextBlock Text="Playback" Style="{StaticResource PageTitle}"/>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}"
                                                  IsChecked="{Binding AutoStopPrevious}"
                                                  AutomationProperties.Name="Only one sound at a time"/>
                                    <StackPanel Margin="9,0,0,0">
                                        <TextBlock Text="Only one sound at a time" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                   MaxWidth="620"
                                                   Text="Stop whatever is already playing as soon as you trigger something new."/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="When a sound is triggered" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PlaybackModes}" SelectedItem="{Binding PlaybackMode}"
                                          Width="260" HorizontalAlignment="Left"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="Overlap layers sounds on top of each other, Solo stops everything else first, Restart retriggers a sound that is already playing."/>

                                <Grid Margin="0,18,0,0">
                                    <TextBlock Text="Maximum sounds at once" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}"
                                               Text="{Binding MaxSimultaneousSounds}"/>
                                </Grid>
                                <Slider Minimum="1" Maximum="64" Value="{Binding MaxSimultaneousSounds}"
                                        TickFrequency="1" IsSnapToTickEnabled="True" MaxWidth="420"
                                        HorizontalAlignment="Left"/>

                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="Stop fade" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}">
                                        <Run Text="{Binding GlobalFadeOutMs}"/><Run Text=" ms"/>
                                    </TextBlock>
                                </Grid>
                                <Slider Minimum="0" Maximum="500" Value="{Binding GlobalFadeOutMs}" MaxWidth="420"
                                        HorizontalAlignment="Left"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="A short fade avoids the click you get from cutting audio dead."/>

                                <Separator Style="{StaticResource SoftSeparator}"/>

                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding StopOnSecondPress}"/>
                                    <TextBlock Text="Pressing a playing sound again stops it" Margin="9,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding RememberHistory}"/>
                                    <TextBlock Text="Remember play history" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}" Margin="0">
                                    <ToggleButton Style="{StaticResource Switch}"
                                                  IsChecked="{Binding DuckMicrophoneWhilePlaying}"/>
                                    <StackPanel Margin="9,0,0,0">
                                        <TextBlock Text="Duck the microphone while a sound plays"/>
                                        <TextBlock Style="{StaticResource MutedText}"
                                                   Text="Keeps your voice from fighting the sound effect."/>
                                    </StackPanel>
                                </StackPanel>

                                <Button Content="Clear play history" HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding ClearHistoryCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================== -->
                    <!-- Library                                             -->
                    <!-- ================================================== -->
                    <StackPanel Visibility="{Binding Section, Converter={StaticResource EqualsToVisibility},
                                             ConverterParameter=Library}">
                        <TextBlock Text="Library &amp; import" Style="{StaticResource PageTitle}"/>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Watched folders" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                           Text="Project Soundboard indexes these folders instead of importing sounds one at a time. Add or remove files in Explorer and the library keeps up."/>

                                <ItemsControl ItemsSource="{Binding Folders}" Margin="0,14,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource InlineCard}" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Path}" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="440"/>
                                                            <Border Background="{DynamicResource AccentSoftBrush}"
                                                                    CornerRadius="7" Padding="7,1" Margin="8,0,0,0"
                                                                    Visibility="{Binding IsMainLibrary,
                                                                                 Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Text="Main library" FontSize="10.5"/>
                                                            </Border>
                                                            <Border Background="{DynamicResource DangerBrush}"
                                                                    CornerRadius="7" Padding="7,1" Margin="8,0,0,0"
                                                                    Visibility="{Binding Exists,
                                                                                 Converter={StaticResource InverseBoolToVisibility}}">
                                                                <TextBlock Text="Missing" FontSize="10.5"
                                                                           Foreground="White"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                            <CheckBox Content="Include subfolders"
                                                                      IsChecked="{Binding Recursive}" FontSize="11.5"/>
                                                            <CheckBox Content="Watch for changes" Margin="16,0,0,0"
                                                                      IsChecked="{Binding Watch}" FontSize="11.5"/>
                                                            <CheckBox Content="Enabled" Margin="16,0,0,0"
                                                                      IsChecked="{Binding Enabled}" FontSize="11.5"/>
                                                        </StackPanel>

                                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,7,0,0">
                                                            <Run Text="{Binding SoundCount, Mode=OneWay, StringFormat=N0}"/><Run Text=" sounds"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <Button Grid.Column="1" Content="Remove" VerticalAlignment="Top"
                                                            Style="{StaticResource GhostButton}" Padding="10,4"
                                                            FontSize="11.5"
                                                            Command="{Binding DataContext.RemoveFolderCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="Add a folder" HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding AddFolderCommand}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Main sound library" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                           Text="Where “Import to main sound library” copies dropped files."/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBox Text="{Binding MainLibraryPath, Mode=OneWay}" IsReadOnly="True"
                                             Width="440" AutomationProperties.Name="Main library folder"/>
                                    <Button Content="Change…" Margin="8,0,0,0"
                                            Command="{Binding ChooseMainLibraryCommand}"/>
                                    <Button Content="Open" Margin="8,0,0,0" Style="{StaticResource GhostButton}"
                                            Command="{Binding OpenMainLibraryCommand}"/>
                                </StackPanel>

                                <Separator Style="{StaticResource SoftSeparator}"/>

                                <TextBlock Text="When files are dropped onto the window"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding ImportBehaviors}" SelectedItem="{Binding ImportBehavior}"
                                          Width="280" HorizontalAlignment="Left"/>

                                <TextBlock Text="When a file of the same name already exists"
                                           Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                                <ComboBox ItemsSource="{Binding ConflictActions}" SelectedItem="{Binding ConflictAction}"
                                          Width="280" HorizontalAlignment="Left"/>

                                <StackPanel Style="{StaticResource SettingRow}" Margin="0,18,0,14">
                                    <ToggleButton Style="{StaticResource Switch}"
                                                  IsChecked="{Binding PreserveFolderStructureOnImport}"/>
                                    <TextBlock Text="Keep folder structure when importing folders" Margin="9,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}"
                                                  IsChecked="{Binding AutoTagFromFolderName}"/>
                                    <TextBlock Text="Tag new sounds with their folder name" Margin="9,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}"
                                                  IsChecked="{Binding DetectDuplicatesOnImport}"/>
                                    <TextBlock Text="Warn about likely duplicates" Margin="9,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding WatchFolders}"/>
                                    <TextBlock Text="Watch folders for changes while running" Margin="9,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}" Margin="0">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding ScanOnStartup}"/>
                                    <TextBlock Text="Rescan folders at startup" Margin="9,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="File types" Style="{StaticResource FieldLabel}" Margin="0,18,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding ExtensionsText, UpdateSourceTrigger=LostFocus}" Width="440"
                                             AutomationProperties.Name="Supported file extensions"/>
                                    <Button Content="Apply" Margin="8,0,0,0"
                                            Command="{Binding ApplyExtensionsCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Library health" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding HealthText}" Style="{StaticResource SecondaryText}"
                                           TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Check now" Command="{Binding CheckLibraryHealthCommand}"/>
                                    <Button Content="Repair missing" Margin="8,0,0,0"
                                            Command="{Binding RepairMissingCommand}"
                                            ToolTip="Re-check missing files in case a drive came back"/>
                                    <Button Content="Remove missing" Margin="8,0,0,0"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding RemoveMissingCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================== -->
                    <!-- Search                                              -->
                    <!-- ================================================== -->
                    <StackPanel Visibility="{Binding Section, Converter={StaticResource EqualsToVisibility},
                                             ConverterParameter=Search}">
                        <TextBlock Text="Search" Style="{StaticResource PageTitle}"/>
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding FuzzyMatching}"/>
                                    <StackPanel Margin="9,0,0,0">
                                        <TextBlock Text="Fuzzy matching" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource MutedText}"
                                                   Text="“wlhm” still finds “Wilhelm Scream”."/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding SearchDisplayName}"/>
                                    <TextBlock Text="Search display names" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding SearchFileName}"/>
                                    <TextBlock Text="Search original file names" Margin="9,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding SearchTags}"/>
                                    <TextBlock Text="Search tags" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding SearchGroup}"/>
                                    <TextBlock Text="Search group names" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}" Margin="0">
                                    <ToggleButton Style="{StaticResource Switch}"
                                                  IsChecked="{Binding RememberRecentSearches}"/>
                                    <TextBlock Text="Remember recent searches" Margin="9,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================== -->
                    <!-- Performance                                         -->
                    <!-- ================================================== -->
                    <StackPanel Visibility="{Binding Section, Converter={StaticResource EqualsToVisibility},
                                             ConverterParameter=Performance}">
                        <TextBlock Text="Performance" Style="{StaticResource PageTitle}"/>
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}"
                                                  IsChecked="{Binding PreloadFrequentSounds}"/>
                                    <StackPanel Margin="9,0,0,0">
                                        <TextBlock Text="Preload favourites and frequently used sounds"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource MutedText}"
                                                   Text="Decoded ahead of time so triggering them costs nothing."/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid>
                                    <TextBlock Text="How many to preload" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}"
                                               Text="{Binding PreloadCount}"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="256" Value="{Binding PreloadCount}" MaxWidth="420"
                                        HorizontalAlignment="Left"/>

                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="Folder scanning threads" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}"
                                               Text="{Binding ScanThreads}"/>
                                </Grid>
                                <Slider Minimum="1" Maximum="32" Value="{Binding ScanThreads}"
                                        TickFrequency="1" IsSnapToTickEnabled="True" MaxWidth="420"
                                        HorizontalAlignment="Left"/>

                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="Cache budget" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}">
                                        <Run Text="{Binding ImageCacheMb}"/><Run Text=" MB"/>
                                    </TextBlock>
                                </Grid>
                                <Slider Minimum="32" Maximum="1024" Value="{Binding ImageCacheMb}"
                                        TickFrequency="32" IsSnapToTickEnabled="True" MaxWidth="420"
                                        HorizontalAlignment="Left"/>

                                <StackPanel Style="{StaticResource SettingRow}" Margin="0,18,0,14">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding LazyLoading}"/>
                                    <TextBlock Text="Load tiles only as they scroll into view" Margin="9,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding CacheImages}"/>
                                    <TextBlock Text="Cache thumbnails in memory" Margin="9,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}" Margin="0">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding BackgroundIndexing}"/>
                                    <TextBlock Text="Index new files in the background" Margin="9,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Separator Style="{StaticResource SoftSeparator}"/>

                                <TextBlock Text="{Binding CacheStatsText}" Style="{StaticResource SecondaryText}"
                                           TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Refresh stats" Command="{Binding RefreshCacheStatsCommand}"/>
                                    <Button Content="Clear caches" Margin="8,0,0,0"
                                            Command="{Binding ClearCachesCommand}"/>
                                    <Button Content="Prune unused thumbnails" Margin="8,0,0,0"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding PruneOrphanImagesCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================== -->
                    <!-- Notifications                                       -->
                    <!-- ================================================== -->
                    <StackPanel Visibility="{Binding Section, Converter={StaticResource EqualsToVisibility},
                                             ConverterParameter=Notifications}">
                        <TextBlock Text="Notifications" Style="{StaticResource PageTitle}"/>
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding ShowToasts}"/>
                                    <TextBlock Text="Show status messages" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}"
                                                  IsChecked="{Binding NotifyOnMissingFiles}"/>
                                    <TextBlock Text="Tell me when a sound file goes missing" Margin="9,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding NotifyOnImport}"/>
                                    <TextBlock Text="Summarise imports when they finish" Margin="9,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}" Margin="0">
                                    <ToggleButton Style="{StaticResource Switch}"
                                                  IsChecked="{Binding NotifyOnDeviceChange}"/>
                                    <TextBlock Text="Tell me when audio devices change" Margin="9,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================== -->
                    <!-- Accessibility                                       -->
                    <!-- ================================================== -->
                    <StackPanel Visibility="{Binding Section, Converter={StaticResource EqualsToVisibility},
                                             ConverterParameter=Accessibility}">
                        <TextBlock Text="Accessibility" Style="{StaticResource PageTitle}"/>
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding HighContrast}"/>
                                    <StackPanel Margin="9,0,0,0">
                                        <TextBlock Text="High contrast mode" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource MutedText}"
                                                   Text="Pure black and white with explicit borders on every control."/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding LargeText}"/>
                                    <TextBlock Text="Large text" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid>
                                    <TextBlock Text="Text scale" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}"
                                               Text="{Binding TextScale, Converter={StaticResource Percent}}"/>
                                </Grid>
                                <Slider Minimum="1" Maximum="1.8" Value="{Binding TextScale}" TickFrequency="0.05"
                                        IsSnapToTickEnabled="True" IsEnabled="{Binding LargeText}"
                                        MaxWidth="420" HorizontalAlignment="Left"/>

                                <TextBlock Text="Colour vision" Style="{StaticResource FieldLabel}" Margin="0,18,0,5"/>
                                <ComboBox ItemsSource="{Binding ColorBlindModes}" SelectedItem="{Binding ColorBlindMode}"
                                          Width="240" HorizontalAlignment="Left"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="Re-maps the success / warning / error colours. Status is always shown with text as well, never colour alone."/>

                                <StackPanel Style="{StaticResource SettingRow}" Margin="0,18,0,14">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding ReducedMotion}"/>
                                    <TextBlock Text="Reduce motion" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}"
                                                  IsChecked="{Binding AlwaysShowFocusOutline}"/>
                                    <TextBlock Text="Always show the keyboard focus outline" Margin="9,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}" Margin="0">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding ScreenReaderHints}"/>
                                    <TextBlock Text="Screen reader labels" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Separator Style="{StaticResource SoftSeparator}"/>

                                <TextBlock Text="Keyboard shortcuts" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" LineHeight="21">
                                    Ctrl + F — focus search<LineBreak/>
                                    Ctrl + Space — pause / resume<LineBreak/>
                                    Ctrl + Shift + S — stop everything<LineBreak/>
                                    Ctrl + R — play something random<LineBreak/>
                                    Ctrl + G — switch layout<LineBreak/>
                                    Ctrl + P — show / hide the details panel<LineBreak/>
                                    F5 — rescan the library<LineBreak/>
                                    Enter or Space — play the selected sound<LineBreak/>
                                    Delete — remove the selected sound from the library
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================== -->
                    <!-- Backup                                              -->
                    <!-- ================================================== -->
                    <StackPanel Visibility="{Binding Section, Converter={StaticResource EqualsToVisibility},
                                             ConverterParameter=Backup}">
                        <TextBlock Text="Backup &amp; restore" Style="{StaticResource PageTitle}"/>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Full backup" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                           Text="Settings, groups, display names, tags, per-sound settings and thumbnails — everything except the audio files themselves."/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Export a backup" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding ExportBackupCommand}"/>
                                    <Button Content="Restore from a file…" Margin="8,0,0,0"
                                            Command="{Binding ImportBackupCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Automatic backups" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                           Text="Taken automatically before anything risky, such as a restore or a settings reset."/>
                                <ItemsControl ItemsSource="{Binding Backups}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12"/>
                                                    <TextBlock Style="{StaticResource MutedText}">
                                                        <Run Text="{Binding CreationTime, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding Length, Mode=OneWay,
                                                              Converter={StaticResource FileSize}}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Restore" Padding="10,4"
                                                        FontSize="11.5" Style="{StaticResource GhostButton}"
                                                        Command="{Binding DataContext.RestoreBackupCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Individual exports" Style="{StaticResource SectionTitle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Export settings" Command="{Binding ExportSettingsCommand}"/>
                                    <Button Content="Export groups" Margin="8,0,0,0"
                                            Command="{Binding ExportGroupsCommand}"/>
                                    <Button Content="Export display names" Margin="8,0,0,0"
                                            Command="{Binding ExportDisplayNamesCommand}"/>
                                    <Button Content="Import display names" Margin="8,0,0,0"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding ImportDisplayNamesCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================== -->
                    <!-- Advanced                                            -->
                    <!-- ================================================== -->
                    <StackPanel Visibility="{Binding Section, Converter={StaticResource EqualsToVisibility},
                                             ConverterParameter=Advanced}">
                        <TextBlock Text="Advanced" Style="{StaticResource PageTitle}"/>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding AllowFileRenaming}"/>
                                    <StackPanel Margin="9,0,0,0">
                                        <TextBlock Text="Allow renaming files on disk" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                   MaxWidth="620"
                                                   Text="Off by default. Display names normally leave your files completely untouched — turn this on only if you want the actual file renamed too."/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding VerboseLogging}"/>
                                    <TextBlock Text="Verbose logging" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingRow}" Margin="0">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding DeveloperMode}"/>
                                    <TextBlock Text="Developer mode" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="Autosave interval" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}">
                                        <Run Text="{Binding MetadataAutosaveSeconds}"/><Run Text=" s"/>
                                    </TextBlock>
                                </Grid>
                                <Slider Minimum="3" Maximum="120" Value="{Binding MetadataAutosaveSeconds}"
                                        MaxWidth="420" HorizontalAlignment="Left"/>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}"/>
                                    <Button Content="Open logs" Margin="8,0,0,0"
                                            Command="{Binding OpenLogFolderCommand}"/>
                                    <Button Content="Reset all settings" Margin="8,0,0,0"
                                            Style="{StaticResource DangerButton}"
                                            Command="{Binding ResetAllSettingsCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                                Visibility="{Binding DeveloperMode, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Diagnostics" Style="{StaticResource SectionTitle}"/>
                                <Border Background="{DynamicResource InputBrush}" CornerRadius="9" Padding="12"
                                        MinHeight="120">
                                    <TextBlock Text="{Binding DiagnosticsText}" FontFamily="Consolas" FontSize="11.5"
                                               TextWrapping="NoWrap"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Refresh" Command="{Binding RefreshDiagnosticsCommand}"/>
                                    <Button Content="Copy" Margin="8,0,0,0"
                                            Command="{Binding CopyDiagnosticsCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}"
                               Margin="0,18,0,0" TextWrapping="Wrap"
                               Visibility="{Binding StatusText, Converter={StaticResource EmptyStringToVisibility}}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
