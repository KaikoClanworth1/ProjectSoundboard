<Window x:Class="ProjectSoundboard.App.Views.GroupPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Move to group"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        SizeToContent="Height" Width="420" MaxHeight="560"
        FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimaryBrush}">

    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="22"
            BorderBrush="{DynamicResource BorderBrushStrong}" BorderThickness="1"
            Margin="12" Effect="{DynamicResource PopupShadow}">
        <StackPanel>
            <TextBlock Text="Move to group" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource SecondaryText}" Margin="0,7,0,0"
                       TextWrapping="Wrap"/>

            <Border Style="{StaticResource InlineCard}" Margin="0,16,0,0" MaxHeight="300" Padding="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="GroupList" Background="Transparent" BorderThickness="0"
                             DisplayMemberPath="Name"
                             MouseDoubleClick="OnDoubleClick"
                             AutomationProperties.Name="Groups">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,7"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="7"
                                                    Padding="{TemplateBinding Padding}" Margin="2,1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource HoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource AccentSoftBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </ScrollViewer>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="No group" Width="104" Style="{StaticResource GhostButton}"
                        Click="OnNoGroup" ToolTip="Take it out of any group"/>
                <Button Content="Cancel" Width="94" Margin="8,0,0,0" IsCancel="True" Click="OnCancel"/>
                <Button Content="Move" Width="104" Margin="8,0,0,0" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Click="OnAccept"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
