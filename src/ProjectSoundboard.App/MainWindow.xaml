<Window x:Class="ProjectSoundboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:ProjectSoundboard.App.Views"
        xmlns:ctl="clr-namespace:ProjectSoundboard.App.Controls"
        Title="Project Soundboard"
        Height="820" Width="1360"
        MinHeight="560" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        AllowDrop="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" CornerRadius="0" GlassFrameThickness="0"
                            ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Space" Modifiers="Control" Command="{Binding TogglePauseCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding StopAllCommand}"/>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding PlayRandomCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RescanCommand}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding TogglePropertiesPanelCommand}"/>
        <KeyBinding Key="G" Modifiers="Control" Command="{Binding CycleViewModeCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScaleTransform" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <!-- ============================================================ -->
            <!-- Title bar                                                    -->
            <!-- ============================================================ -->
            <Border Grid.Row="0" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border Width="20" Height="20" CornerRadius="6"
                                Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                            <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource TextOnAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Project Soundboard" Margin="10,0,0,0" FontWeight="SemiBold"
                                   FontSize="12.5" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Breadcrumb}" Margin="16,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5"
                                   TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;"
                                Click="OnMinimiseClick" ToolTip="Minimise"
                                AutomationProperties.Name="Minimise"/>
                        <Button Style="{StaticResource TitleBarButton}" Content="&#xE922;"
                                Click="OnMaximiseClick" ToolTip="Maximise"
                                AutomationProperties.Name="Maximise"/>
                        <Button Style="{StaticResource TitleBarButton}" Content="&#xE8BB;"
                                Click="OnCloseClick" ToolTip="Close"
                                AutomationProperties.Name="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- Body: navigation rail + page                                 -->
            <!-- ============================================================ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="78" Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,1,0">
                    <StackPanel Margin="0,10">
                        <StackPanel.Resources>
                            <Style TargetType="RadioButton" x:Key="NavButton">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Margin" Value="8,3"/>
                                <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="10"
                                                    Padding="0,9">
                                                <StackPanel>
                                                    <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}"
                                                               FontFamily="Segoe MDL2 Assets" FontSize="17"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                                               FontSize="10.5" Margin="0,5,0,0"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource HoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource AccentSoftBrush}"/>
                                                    <Setter TargetName="Glyph" Property="Foreground"
                                                            Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="Label" Property="Foreground"
                                                            Value="{DynamicResource TextPrimaryBrush}"/>
                                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>

                        <RadioButton Style="{StaticResource NavButton}" Content="Sounds" Tag="&#xE8A9;"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool},
                                                 ConverterParameter=Library, Mode=TwoWay}"
                                     AutomationProperties.Name="Sounds library"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="Audio" Tag="&#xE767;"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool},
                                                 ConverterParameter=Audio, Mode=TwoWay}"
                                     AutomationProperties.Name="Audio routing"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="Mic" Tag="&#xE720;"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool},
                                                 ConverterParameter=Microphone, Mode=TwoWay}"
                                     AutomationProperties.Name="Microphone passthrough"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="Hotkeys" Tag="&#xE765;"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool},
                                                 ConverterParameter=Hotkeys, Mode=TwoWay}"
                                     AutomationProperties.Name="Hotkeys"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="Settings" Tag="&#xE713;"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool},
                                                 ConverterParameter=Settings, Mode=TwoWay}"
                                     AutomationProperties.Name="Settings"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1">
                    <views:LibraryView
                        Visibility="{Binding CurrentPage,
                                     Converter={StaticResource EqualsToVisibility},
                                     ConverterParameter=Library}"/>
                    <views:AudioView DataContext="{Binding Audio}"
                                     Visibility="{Binding DataContext.CurrentPage,
                                                  RelativeSource={RelativeSource AncestorType=Window},
                                                  Converter={StaticResource EqualsToVisibility},
                                                  ConverterParameter=Audio}"/>
                    <views:MicrophoneView DataContext="{Binding Microphone}"
                                          Visibility="{Binding DataContext.CurrentPage,
                                                       RelativeSource={RelativeSource AncestorType=Window},
                                                       Converter={StaticResource EqualsToVisibility},
                                                       ConverterParameter=Microphone}"/>
                    <views:HotkeysView DataContext="{Binding Hotkeys}"
                                       Visibility="{Binding DataContext.CurrentPage,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource EqualsToVisibility},
                                                    ConverterParameter=Hotkeys}"/>
                    <views:SettingsView DataContext="{Binding Settings}"
                                        Visibility="{Binding DataContext.CurrentPage,
                                                     RelativeSource={RelativeSource AncestorType=Window},
                                                     Converter={StaticResource EqualsToVisibility},
                                                     ConverterParameter=Settings}"/>
                </Grid>
            </Grid>

            <!-- ============================================================ -->
            <!-- Transport bar                                                -->
            <!-- ============================================================ -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,1"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE892;"
                                FontFamily="Segoe MDL2 Assets" Command="{Binding PlayPreviousCommand}"
                                ToolTip="Previous sound" AutomationProperties.Name="Previous sound"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE769;"
                                FontFamily="Segoe MDL2 Assets" Command="{Binding TogglePauseCommand}"
                                ToolTip="Pause / resume (Ctrl+Space)"
                                AutomationProperties.Name="Pause or resume"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE893;"
                                FontFamily="Segoe MDL2 Assets" Command="{Binding PlayNextCommand}"
                                ToolTip="Next sound" AutomationProperties.Name="Next sound"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8B1;"
                                FontFamily="Segoe MDL2 Assets" Command="{Binding PlayRandomCommand}"
                                ToolTip="Play something random (Ctrl+R)"
                                AutomationProperties.Name="Play random sound"/>

                        <Border Width="1" Background="{DynamicResource BorderBrushSoft}" Margin="8,4"/>

                        <Button Style="{StaticResource DangerButton}" Content="Stop all"
                                Command="{Binding StopAllCommand}" Padding="14,7"
                                ToolTip="Stop everything (Ctrl+Shift+S)"/>

                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9"
                                Padding="10,4" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding PlayingCount, Converter={StaticResource CountToVisibility}}">
                            <TextBlock FontSize="11.5" FontWeight="SemiBold">
                                <Run Text="{Binding PlayingCount, Mode=OneWay}"/><Run Text=" playing"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Column="1" Margin="26,0" VerticalAlignment="Center" MaxWidth="440">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Virtual mic" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"/>
                        <ctl:LevelMeterControl Grid.Row="0" Grid.Column="1" Height="9" Margin="0,3"
                                               Peak="{Binding VirtualMicPeak}" Rms="{Binding VirtualMicRms}"
                                               AutomationProperties.Name="Virtual microphone output level"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Your mic" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"/>
                        <ctl:LevelMeterControl Grid.Row="1" Grid.Column="1" Height="9" Margin="0,3"
                                               Peak="{Binding MicOutputPeak}"
                                               AutomationProperties.Name="Microphone level"/>
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton Style="{StaticResource Switch}"
                                      IsChecked="{Binding AutoStopPrevious}"
                                      VerticalAlignment="Center"
                                      ToolTip="Stop whatever is playing when you trigger a new sound"
                                      AutomationProperties.Name="Only one sound at a time"/>
                        <TextBlock Text="One at a time" Margin="8,0,14,0" VerticalAlignment="Center"
                                   Style="{StaticResource SecondaryText}"/>

                        <ToggleButton Style="{StaticResource Switch}"
                                      IsChecked="{Binding Microphone.PassthroughEnabled}"
                                      VerticalAlignment="Center"
                                      ToolTip="Send your microphone through the virtual cable"
                                      AutomationProperties.Name="Microphone passthrough"/>
                        <TextBlock Text="Mic thru" Margin="8,0,14,0" VerticalAlignment="Center"
                                   Style="{StaticResource SecondaryText}"/>

                        <!-- Muted state is shown by both a different glyph and a colour, never
                             colour alone, so it still reads in high contrast and colour-blind modes. -->
                        <Button FontFamily="Segoe MDL2 Assets" Command="{Binding Microphone.ToggleMuteCommand}"
                                ToolTip="Mute microphone" AutomationProperties.Name="Mute microphone">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Content" Value="&#xE720;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Microphone.Muted}" Value="True">
                                            <Setter Property="Content" Value="&#xE74F;"/>
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button FontFamily="Segoe MDL2 Assets" Command="{Binding ToggleSoundboardMuteCommand}"
                                ToolTip="Mute the soundboard" AutomationProperties.Name="Mute soundboard">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Content" Value="&#xE767;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SoundboardMuted}" Value="True">
                                            <Setter Property="Content" Value="&#xE74F;"/>
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"
                                   Margin="10,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Slider Width="130" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                Value="{Binding MasterVolume}" ToolTip="Master volume"
                                AutomationProperties.Name="Master volume"/>
                        <TextBlock Text="{Binding MasterVolume, Converter={StaticResource Percent}}"
                                   Width="42" TextAlignment="Right" VerticalAlignment="Center"
                                   Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- Status bar                                                   -->
            <!-- ============================================================ -->
            <Border Grid.Row="3" Background="{DynamicResource SidebarBrush}">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VirtualMicHealthy}" Value="False">
                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding VirtualMicDeviceText}" Margin="7,0,0,0"
                                   Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                   MaxWidth="280" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding VirtualMicTooltip}"/>

                        <TextBlock Text="·" Margin="10,0" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding LatencyText}" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" ToolTip="Estimated output latency"/>

                        <TextBlock Text="·" Margin="10,0" Style="{StaticResource MutedText}"/>
                        <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center">
                            <Run Text="{Binding ResultCount, Mode=OneWay, StringFormat=N0}"/><Run Text=" shown"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource MutedText}"
                                   Margin="0,0,12,0" VerticalAlignment="Center"
                                   Visibility="{Binding ScanStatus, Converter={StaticResource EmptyStringToVisibility}}"/>
                        <ProgressBar Width="110" Height="4" IsIndeterminate="True" VerticalAlignment="Center"
                                     Margin="0,0,12,0"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" MaxWidth="460"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Drag and drop overlay -->
            <Border x:Name="DropOverlay" Grid.RowSpan="4" Background="{DynamicResource OverlayBrush}"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="18" Padding="46,34"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Drop to add sounds" FontSize="19" FontWeight="SemiBold"
                                   Margin="0,14,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="Files and folders both work — you'll choose where they go next."
                                   Style="{StaticResource SecondaryText}" Margin="0,6,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
