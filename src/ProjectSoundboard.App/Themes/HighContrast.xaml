<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        High contrast theme (Settings → Accessibility). Pure black backgrounds, white text
        and saturated primaries, with every border made explicit so control edges are never
        implied by colour alone.
    -->

    <Color x:Key="WindowBackgroundColor">#000000</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#000000"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#000000"/>
    <SolidColorBrush x:Key="ElevatedBrush" Color="#101010"/>
    <SolidColorBrush x:Key="InputBrush" Color="#000000"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#E6000000"/>

    <SolidColorBrush x:Key="HoverBrush" Color="#333333"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#4D4D4D"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#004C99"/>

    <SolidColorBrush x:Key="BorderBrushSoft" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrushStrong" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#D9D9D9"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#000000"/>

    <Color x:Key="AccentColor">#FFFF00</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#FFFF00"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFFF66"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#CCCC00"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#332F00"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#00FF00"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFF00"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF4040"/>
    <SolidColorBrush x:Key="MeterLowBrush" Color="#00FF00"/>
    <SolidColorBrush x:Key="MeterMidBrush" Color="#FFFF00"/>
    <SolidColorBrush x:Key="MeterHighBrush" Color="#FF4040"/>
    <SolidColorBrush x:Key="WaveformBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WaveformPlayedBrush" Color="#FFFF00"/>

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#FFFF00"/>

    <!-- Shadows read as mud against pure black, so they are switched off here. -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="0" ShadowDepth="0" Opacity="0"/>

</ResourceDictionary>
