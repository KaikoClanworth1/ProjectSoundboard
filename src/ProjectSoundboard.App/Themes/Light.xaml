<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme. Mirrors every key defined in Dark.xaml. -->

    <Color x:Key="WindowBackgroundColor">#F4F6F9</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#EDEFF4"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ElevatedBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBrush" Color="#EEF1F6"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#99101216"/>

    <SolidColorBrush x:Key="HoverBrush" Color="#E6EAF2"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#DAE0EC"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#DCE4FF"/>

    <SolidColorBrush x:Key="BorderBrushSoft" Color="#E2E6EE"/>
    <SolidColorBrush x:Key="BorderBrushStrong" Color="#C9D0DD"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111520"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#525B6D"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#818B9E"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>

    <Color x:Key="AccentColor">#3B62E8</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#3B62E8"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5478F5"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2C4FCC"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E4EAFF"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="MeterLowBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="MeterMidBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="MeterHighBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="WaveformBrush" Color="#A9B4CA"/>
    <SolidColorBrush x:Key="WaveformPlayedBrush" Color="#3B62E8"/>

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C6CDDB"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#AAB3C5"/>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="14" ShadowDepth="2"
                      Direction="270" Opacity="0.14" Color="#1B2233"/>
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="26" ShadowDepth="5"
                      Direction="270" Opacity="0.22" Color="#1B2233"/>

</ResourceDictionary>
