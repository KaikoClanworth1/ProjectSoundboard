<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme. Every other theme file must define exactly these keys. -->

    <!-- Surfaces, from furthest back to closest to the user -->
    <Color x:Key="WindowBackgroundColor">#0F1115</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0F1115"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#12151C"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#171A21"/>
    <SolidColorBrush x:Key="ElevatedBrush" Color="#1E222B"/>
    <SolidColorBrush x:Key="InputBrush" Color="#22262F"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#CC080A0E"/>

    <!-- Hover / pressed / selected states -->
    <SolidColorBrush x:Key="HoverBrush" Color="#252A35"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#2E3440"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#2A3350"/>

    <!-- Lines -->
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#232833"/>
    <SolidColorBrush x:Key="BorderBrushStrong" Color="#333A47"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E7EAF0"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA3B2"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7484"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>

    <!-- Accent (overridden at runtime from Settings → Appearance) -->
    <Color x:Key="AccentColor">#6C8CFF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#6C8CFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#8AA3FF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#5876E0"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#242C48"/>

    <!-- Semantic -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="MeterLowBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="MeterMidBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="MeterHighBrush" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="WaveformBrush" Color="#4F5C7A"/>
    <SolidColorBrush x:Key="WaveformPlayedBrush" Color="#6C8CFF"/>

    <!-- Scrollbars -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#333A47"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#454E5E"/>

    <!-- Drop shadow used by cards, popups and the properties panel -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="3"
                      Direction="270" Opacity="0.45" Color="#000000"/>
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="28" ShadowDepth="6"
                      Direction="270" Opacity="0.6" Color="#000000"/>

</ResourceDictionary>
